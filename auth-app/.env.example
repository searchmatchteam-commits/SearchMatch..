# Cadena de conexión de Supabase
# Dashboard -> Project Settings -> Database -> Connection string -> URI
# Recuerda reemplazar <password> por la contraseña real del usuario postgres
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

# Secreto para firmar las cookies de sesión (usa una cadena larga y aleatoria)
SESSION_SECRET=cambia-esta-cadena-por-una-larga-y-aleatoria

# Puerto del servidor
PORT=3000
