# Copia este archivo como .env y completa los valores (nunca subas el .env al repositorio).
DATABASE_URL=postgresql://usuario:contrasena@host:5432/postgres
SESSION_SECRET=
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://xxxx.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
# URL pública de la app (enlaces de invitación y retorno de las pasarelas de pago)
APP_URL=http://localhost:3000
# TO-013: clave AES-256-GCM de las credenciales de las pasarelas (64 caracteres hexadecimales).
# Para crear una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASARELAS_CLAVE=
# "no" apaga la tarea programada de cada minuto (cierre de inscripciones vencidas, etc.)
TAREAS_PROGRAMADAS=
