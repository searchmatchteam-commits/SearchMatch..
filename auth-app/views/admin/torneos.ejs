<%- include('../partials/admin-inicio', { seccion }) %>

<section class="eq">
  <div class="contenedor">
    <header class="eq-cabecera revelar">
      <div class="eq-cabecera__texto">
        <h1 class="eq-cabecera__titulo">Torneos</h1>
        <p class="eq-cabecera__stats">Todos los torneos, también los borradores y cancelados. Las acciones dependen del estado de cada uno.</p>
      </div>
      <div class="eq-cabecera__acciones">
        <a class="btn btn--verde btn--grande" href="/admin/torneos/nuevo"><span aria-hidden="true">+</span> Crear torneo</a>
      </div>
    </header>

    <% if (aviso) { %><div class="alerta alerta--exito" role="status"><%= aviso %></div><% } %>

    <%- include('../partials/listado-barra', { listado, filtrosVista, placeholder: 'Nombre del torneo o recinto' }) %>

    <% if (torneos.length === 0) { %>
      <%- include('../partials/listado-vacio', { listado, mensaje: 'Aún no hay torneos' }) %>
    <% } else { %>
      <div class="dash-panel eq-panel sm-tabla-contenedor">
        <table class="sm-tabla sm-tabla--listado">
          <thead>
            <tr>
              <%- include('../partials/listado-th', { listado, clave: 'nombre', texto: 'Torneo' }) %>
              <%- include('../partials/listado-th', { listado, clave: 'estado', texto: 'Estado' }) %>
              <%- include('../partials/listado-th', { listado, clave: 'inicio', texto: 'Fechas' }) %>
              <%- include('../partials/listado-th', { listado, clave: 'inscritos', texto: 'Inscritos' }) %>
              <%- include('../partials/listado-th', { listado, clave: 'precio', texto: 'Precio' }) %>
              <%- include('../partials/listado-th', { listado, clave: 'recaudado', texto: 'Recaudación' }) %>
              <th scope="col">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% torneos.forEach(function (t) { %>
              <tr>
                <td data-titulo="Torneo" class="sm-tabla__texto">
                  <a href="/admin/torneos/<%= t.id %>"><strong><%= t.nombre %></strong></a>
                  <small class="sm-tabla__sub"><%= t.formatoTexto %> · <%= t.modalidad %> · <%= t.nivelTexto %><%= t.recinto ? ` · ${t.recinto}` : '' %></small>
                </td>
                <td data-titulo="Estado"><span class="sm-estado sm-estado--torneo-<%= t.estado %>"><%= t.estadoTexto %></span></td>
                <td data-titulo="Fechas">
                  <%= t.fechaInicioTexto.corta || 'Por confirmar' %><%= t.fechaTermino ? ` – ${t.fechaTerminoTexto.corta}` : '' %>
                  <% if (t.fechaLimite) { %><small class="sm-tabla__sub">Inscripción hasta el <%= t.fechaLimiteTexto.corta %></small><% } %>
                </td>
                <td data-titulo="Inscritos"><%= t.inscritos %>/<%= t.cupoMax %><% if (t.reservados > 0) { %> <small class="sm-tabla__sub">+<%= t.reservados %> pagando</small><% } %></td>
                <td data-titulo="Precio"><%= t.precioTexto %></td>
                <td data-titulo="Recaudación"><%= formatoCLP(t.recaudado) %></td>
                <td data-titulo="Acciones">
                  <details class="sm-accion sm-menu-acciones">
                    <summary class="btn btn--chico btn--contorno">Acciones<span class="solo-lectores"> de <%= t.nombre %></span></summary>
                    <div class="sm-menu-acciones__lista">
                      <a class="btn btn--chico btn--contorno" href="/admin/torneos/<%= t.id %>">Ver</a>
                      <% if (t.acciones.includes('editar')) { %><a class="btn btn--chico btn--contorno" href="/admin/torneos/<%= t.id %>/editar">Editar</a><% } %>
                      <% if (t.acciones.includes('publicar')) { %>
                        <form action="/admin/torneos/<%= t.id %>/publicar" method="POST"
                              data-confirmar="Pasará a Inscripciones abiertas, lo verán los jugadores y se avisará a los capitanes de equipos que calzan con el torneo."
                              data-confirmar-titulo="¿Publicar <%= t.nombre %>?" data-confirmar-boton="Publicar">
                          <button type="submit" class="btn btn--chico btn--verde">Publicar</button>
                        </form>
                      <% } %>
                      <% if (t.acciones.includes('cerrar')) { %>
                        <form action="/admin/torneos/<%= t.id %>/cerrar" method="POST"
                              data-confirmar="Ya no se aceptarán inscripciones nuevas y las pendientes de pago expiran."
                              data-confirmar-titulo="¿Cerrar las inscripciones de <%= t.nombre %>?" data-confirmar-boton="Cerrar inscripciones">
                          <button type="submit" class="btn btn--chico btn--contorno">Cerrar inscripciones</button>
                        </form>
                      <% } %>
                      <% if (t.acciones.includes('fixture')) { %>
                        <form action="/admin/torneos/<%= t.id %>/empezar" method="POST"
                              data-confirmar="Se arma el fixture con los equipos confirmados y el torneo pasa a En curso."
                              data-confirmar-titulo="¿Generar el fixture de <%= t.nombre %>?" data-confirmar-boton="Generar fixture">
                          <button type="submit" class="btn btn--chico btn--verde">Generar fixture</button>
                        </form>
                      <% } %>
                      <% if (t.acciones.includes('eliminar')) { %>
                        <form action="/admin/torneos/<%= t.id %>/eliminar" method="POST"
                              data-confirmar="El borrador se elimina definitivamente." data-confirmar-titulo="¿Eliminar <%= t.nombre %>?" data-confirmar-boton="Eliminar">
                          <button type="submit" class="btn btn--chico btn--contorno sm-btn-peligro">Eliminar</button>
                        </form>
                      <% } %>
                    </div>
                  </details>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <%- include('../partials/listado-pie', { listado }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/admin-fin') %>
