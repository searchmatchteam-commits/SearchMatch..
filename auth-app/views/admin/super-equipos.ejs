<%- include('../partials/header') %>

<%- include('../partials/fondo-cyber', { variante: 'perspectiva' }) %>

<section class="eq">
  <div class="contenedor">
    <header class="eq-cabecera revelar">
      <div class="eq-cabecera__texto">
        <span class="dash-chip"><span class="badge__punto" aria-hidden="true"></span>Superadministración</span>
        <h1 class="eq-cabecera__titulo">Equipos</h1>
        <p class="eq-cabecera__stats">Elimina equipos de forma definitiva, junto con sus desafíos y partidos.</p>
      </div>
    </header>

    <%- include('../partials/admin-nav', { seccion }) %>

    <form class="dash-panel eq-panel sm-filtros sm-filtros--linea" method="GET" action="/admin/super/equipos" role="search">
      <div class="campo">
        <label for="texto">Buscar por nombre del equipo o correo del capitán</label>
        <input type="search" id="texto" name="texto" value="<%= texto %>" placeholder="Ej. Los Cracks o juan@correo.cl" />
      </div>
      <div class="sm-form__acciones">
        <button type="submit" class="btn btn--verde">Buscar</button>
        <% if (texto) { %><a class="btn btn--contorno" href="/admin/super/equipos">Ver todos</a><% } %>
      </div>
    </form>

    <% if (equipos.length === 0) { %>
      <div class="dash-panel eq-panel sm-vacio">
        <p class="sm-vacio__titulo"><%= texto ? `No hay equipos que coincidan con "${texto}"` : 'Aún no hay equipos' %></p>
        <% if (texto) { %><a class="btn btn--contorno" href="/admin/super/equipos">Ver todos</a><% } %>
      </div>
    <% } else { %>
      <div class="dash-panel eq-panel">
        <ul class="sm-filas sm-filas--cuentas">
          <% equipos.forEach(function (e) {
               const avisoDesafios = e.desafios > 0 ? ` También se borran sus ${e.desafios} desafíos y los partidos asociados, incluso del historial del equipo rival.` : ''; %>
            <li class="sm-fila <%= e.activo ? '' : 'sm-fila--inactiva' %>">
              <span class="sm-fila__principal">
                <strong><%= e.nombre %></strong>
                <small>Capitán: <%= e.capitan %> · <%= e.comuna %></small>
              </span>
              <span class="sm-rol"><%= e.integrantes %> <%= e.integrantes === 1 ? 'integrante' : 'integrantes' %></span>
              <span class="sm-estado <%= e.activo ? 'sm-estado--activo' : 'sm-estado--inactivo' %>"><%= e.activo ? 'Activo' : 'Inactivo' %></span>
              <span class="sm-fila__accion">
                <form action="/admin/super/equipos/<%= e.id %>/eliminar" method="POST"
                      data-confirmar="Esta acción no se puede deshacer. Se avisará a sus <%= e.integrantes %> integrantes.<%= avisoDesafios %>"
                      data-confirmar-titulo="¿Eliminar el equipo <%= e.nombre %>?" data-confirmar-boton="Eliminar">
                  <input type="hidden" name="texto" value="<%= texto %>" />
                  <button type="submit" class="btn btn--contorno btn--chico sm-btn-peligro">Eliminar</button>
                </form>
              </span>
            </li>
          <% }) %>
        </ul>
        <% if (equipos.length === 50) { %><p class="dash-panel__nota">Se muestran los primeros 50: afina la búsqueda para ver otros.</p><% } %>
      </div>
    <% } %>
  </div>
</section>

<p class="panel-aviso <%= aviso ? 'panel-aviso--visible' : '' %>" role="status" aria-live="polite" data-aviso><%= aviso || '' %></p>

<%- include('../partials/dock', { activo: 'admin' }) %>

<%- include('../partials/footer') %>
