<%- include('../partials/admin-inicio', { seccion }) %>

<%
  const advertenciaReservas = cancha.reservas_futuras > 0
    ? ` Atención: tiene ${cancha.reservas_futuras} ${cancha.reservas_futuras === 1 ? 'reserva confirmada futura' : 'reservas confirmadas futuras'}.`
    : '';
  const erroresB = locals.erroresBloque || {};
%>
<section class="eq">
  <div class="contenedor">
    <header class="eq-cabecera revelar">
      <div class="eq-cabecera__texto">
        <%- include('../partials/boton-volver', { fallbackUrl: `/admin/recintos/${cancha.id_recinto}` }) %>
        <span class="sm-estado <%= cancha.activo ? 'sm-estado--activo' : 'sm-estado--inactivo' %>"><%= cancha.activo ? 'Activa' : 'Inactiva' %></span>
        <h1 class="eq-cabecera__titulo"><%= cancha.nombre %></h1>
        <p class="eq-cabecera__stats">
          <a href="/admin/recintos/<%= cancha.id_recinto %>"><%= cancha.recinto %></a> · <%= cancha.modalidad %> (<%= cancha.jugadores %> jugadores)
        </p>
      </div>
      <div class="eq-cabecera__acciones">
        <% if (cancha.activo) { %>
          <form action="/admin/canchas/<%= cancha.id %>/desactivar" method="POST"
                data-confirmar="Dejará de mostrarse y no se podrán hacer nuevas reservas ni partidos en ella. Las demás canchas del recinto siguen disponibles.<%= advertenciaReservas %>"
                data-confirmar-titulo="¿Desactivar <%= cancha.nombre %>?" data-confirmar-boton="Desactivar">
            <button type="submit" class="btn btn--contorno btn--grande sm-btn-peligro">Desactivar</button>
          </form>
        <% } else { %>
          <form action="/admin/canchas/<%= cancha.id %>/activar" method="POST"
                data-confirmar="<%= cancha.recinto_activo ? 'Volverá a mostrarse a los usuarios y se podrá reservar.' : 'Quedará activa, pero NO será visible mientras su recinto esté inactivo.' %>"
                data-confirmar-titulo="¿Activar <%= cancha.nombre %>?" data-confirmar-boton="Activar">
            <button type="submit" class="btn btn--verde btn--grande">Activar</button>
          </form>
        <% } %>
      </div>
    </header>

    <% if (!cancha.recinto_activo) { %>
      <p class="sm-aviso-limite" role="note">Su recinto está inactivo: esta cancha no se muestra a los usuarios aunque esté activa.</p>
    <% } %>

    <div class="sm-columnas">
      <div class="dash-panel eq-panel revelar">
        <header class="dash-panel__cabecera">
          <h2 class="dash-panel__titulo">Datos de la cancha</h2>
        </header>
        <% if (errores.length > 0) { %>
          <div class="alerta alerta--error" role="alert"><%= errores[0] %></div>
        <% } %>
        <% if (advertencia) { %>
          <div class="alerta sm-alerta-advertencia" role="alert"><%= advertencia %></div>
        <% } %>
        <form action="/admin/canchas/<%= cancha.id %>/editar" method="POST" class="formulario sm-form" novalidate data-sm-validar>
          <%- include('../partials/sm-cancha-campos', { datos, erroresCampo, modalidades }) %>
          <% if (advertencia) { %><input type="hidden" name="confirmado" value="si" /><% } %>
          <p class="campo__ayuda">Las reservas ya confirmadas mantienen el costo con que se reservaron.</p>
          <div class="sm-form__acciones">
            <button type="submit" class="btn btn--verde"><%= advertencia ? 'Guardar de todas formas' : 'Guardar cambios' %></button>
            <a class="btn btn--contorno" href="/admin/canchas/<%= cancha.id %>">Cancelar</a>
          </div>
        </form>
      </div>

      <div class="dash-panel eq-panel revelar" id="nuevo-bloque">
        <header class="dash-panel__cabecera">
          <h2 class="dash-panel__titulo">Agregar horario</h2>
        </header>
        <% if (Object.keys(erroresB).length > 0) { %>
          <div class="alerta alerta--error" role="alert"><%= Object.values(erroresB)[0] %></div>
        <% } %>
        <form action="/admin/canchas/<%= cancha.id %>/disponibilidad#horario" method="POST" class="formulario sm-form" novalidate data-sm-validar>
          <div class="campo <%= erroresB.dia ? 'campo--error' : '' %>">
            <label for="dia">Día</label>
            <select id="dia" name="dia" required data-mensaje="Elige el día." aria-describedby="dia-error">
              <option value="">Elige el día</option>
              <% dias.forEach(function (d) { %>
                <option value="<%= d.clave %>" <%= datosBloque.dia === d.clave ? 'selected' : '' %>><%= d.nombre %></option>
              <% }) %>
            </select>
            <small class="campo__error" id="dia-error"><%= erroresB.dia || '' %></small>
          </div>
          <div class="formulario__fila">
            <div class="campo <%= erroresB.apertura ? 'campo--error' : '' %>">
              <label for="apertura">Apertura</label>
              <input type="time" id="apertura" name="apertura" value="<%= datosBloque.apertura || '' %>" required data-mensaje="Indica la hora de apertura." aria-describedby="apertura-error" />
              <small class="campo__error" id="apertura-error"><%= erroresB.apertura || '' %></small>
            </div>
            <div class="campo <%= erroresB.cierre ? 'campo--error' : '' %>">
              <label for="cierre">Cierre</label>
              <input type="time" id="cierre" name="cierre" value="<%= datosBloque.cierre || '' %>" required data-mensaje="Indica la hora de cierre." aria-describedby="cierre-error" />
              <small class="campo__error" id="cierre-error"><%= erroresB.cierre || '' %></small>
            </div>
          </div>
          <div class="sm-form__acciones">
            <button type="submit" class="btn btn--verde">Agregar horario</button>
          </div>
        </form>
      </div>
    </div>

    <div class="dash-panel eq-panel revelar" id="horario">
      <header class="dash-panel__cabecera">
        <h2 class="dash-panel__titulo">Horario semanal</h2>
      </header>
      <ul class="sm-horario">
        <% horario.forEach(function (dia) { %>
          <li class="sm-horario__dia <%= dia.bloques.length === 0 ? 'sm-horario__dia--cerrado' : '' %>">
            <span class="sm-horario__nombre"><%= dia.nombre %></span>
            <% if (dia.bloques.length === 0) { %>
              <span class="sm-horario__cerrado">Cerrado</span>
            <% } else { %>
              <span class="sm-horario__bloques">
                <% dia.bloques.forEach(function (b) {
                     const avisoReservas = b.reservasFuturas > 0 ? ` Atención: hay ${b.reservasFuturas} ${b.reservasFuturas === 1 ? 'reserva confirmada futura' : 'reservas confirmadas futuras'} en este horario.` : '';
                     const avisoCerrado = dia.bloques.length === 1 ? ` Es el único horario del ${dia.nombre.toLowerCase()}: ese día quedará cerrado.` : ''; %>
                  <span class="sm-bloque">
                    <%= b.apertura %>–<%= b.cierre %>
                    <form action="/admin/disponibilidad/<%= b.id %>/eliminar" method="POST"
                          data-confirmar="Dejará de mostrarse como disponible.<%= avisoCerrado %><%= avisoReservas %>"
                          data-confirmar-titulo="¿Eliminar <%= dia.nombre %> <%= b.apertura %>–<%= b.cierre %>?" data-confirmar-boton="Eliminar">
                      <button type="submit" class="sm-bloque__quitar" aria-label="Eliminar el horario <%= dia.nombre %> <%= b.apertura %> a <%= b.cierre %>">×</button>
                    </form>
                  </span>
                <% }) %>
              </span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>

<%- include('../partials/admin-fin') %>
