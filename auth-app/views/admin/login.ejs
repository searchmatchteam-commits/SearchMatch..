<%- include('../partials/header') %>

<%- include('../partials/fondo-cyber', { variante: 'pizarra' }) %>

<%# AP-001 · Acceso exclusivo del panel. Sin registro ni enlaces a la app de jugadores. %>
<section class="auth auth--login sm-admin-login">
  <div class="tarjeta auth__tarjeta">
    <span class="auth__filo" aria-hidden="true"></span>

    <span class="etiqueta-verde">Acceso restringido</span>
    <h1 class="auth__titulo">Panel de administración</h1>
    <p class="auth__subtitulo">Ingresa con la cuenta de administrador que te asignaron.</p>

    <% if (aviso) { %>
      <div class="alerta alerta--exito" role="status"><%= aviso %></div>
    <% } %>

    <form action="/admin/login" method="POST" class="formulario sm-form" novalidate data-sm-validar>
      <div class="campo">
        <label for="correo">Correo</label>
        <div class="campo__control">
          <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
          <input type="email" id="correo" name="correo" value="<%= correo %>" autocomplete="username" required data-mensaje="Ingresa tu correo." />
        </div>
      </div>
      <div class="campo">
        <label for="password">Contraseña</label>
        <div class="campo__control">
          <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
          <input type="password" id="password" name="password" autocomplete="current-password" required data-mensaje="Ingresa tu contraseña." />
          <%- include('../partials/sm-ojo', { campo: 'password' }) %>
        </div>
      </div>

      <button type="submit" class="btn btn--verde btn--bloque btn--grande">Ingresar</button>
    </form>

    <% if (errores.length > 0) { %>
      <div class="alerta alerta--error" role="alert"><ul><% errores.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
    <% } %>

    <p class="auth__pie"><a href="/recuperar">¿Olvidaste tu contraseña?</a></p>
  </div>
</section>

<%- include('../partials/footer') %>
