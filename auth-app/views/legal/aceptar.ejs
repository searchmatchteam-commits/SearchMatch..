<%- include('../partials/header') %>

<%- include('../partials/cursor-luz') %>

<section class="eq">
  <div class="contenedor sm-legal">
    <header class="eq-cabecera revelar">
      <div class="eq-cabecera__texto">
        <% if (pedirEdad) { %>
          <span class="dash-chip"><span class="badge__punto" aria-hidden="true"></span>Último paso</span>
          <h1 class="eq-cabecera__titulo">Completa tu registro</h1>
          <p class="eq-cabecera__stats">SearchMatch es solo para mayores de 18 años. Confirma tu fecha de nacimiento y acepta los términos.</p>
        <% } else { %>
          <span class="dash-chip"><span class="badge__punto" aria-hidden="true"></span>Actualización</span>
          <h1 class="eq-cabecera__titulo">Actualizamos nuestros términos</h1>
          <p class="eq-cabecera__stats">Léelos y acéptalos para seguir usando SearchMatch.</p>
        <% } %>
      </div>
    </header>

    <div class="dash-panel eq-panel revelar">
      <ul class="sm-lista-docs">
        <li>
          <a href="/terminos" target="_blank" rel="noopener"><%= terminos.titulo %></a>
          <span>Versión <%= terminos.version %> · <%= terminos.fecha %></span>
        </li>
        <li>
          <a href="/privacidad" target="_blank" rel="noopener"><%= privacidad.titulo %></a>
          <span>Versión <%= privacidad.version %> · <%= privacidad.fecha %></span>
        </li>
      </ul>

      <% if (error) { %>
        <div class="alerta alerta--error" role="alert"><%= error %></div>
      <% } %>

      <form autocomplete="off" action="/aceptar-terminos" method="POST" class="sm-form" data-requiere-aceptar>
        <% if (pedirEdad) { %>
          <div class="campo<%= errorFecha ? ' campo--error' : '' %>">
            <label for="fecha_nacimiento">Fecha de nacimiento</label>
            <div class="campo__control">
              <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" value="<%= fechaNacimiento %>"
                     max="<%= new Date().toISOString().slice(0, 10) %>" autocomplete="off"
                     aria-describedby="fecha_nacimiento-error" required />
            </div>
            <small class="campo__error" id="fecha_nacimiento-error"><%= errorFecha || '' %></small>
          </div>
        <% } %>
        <label class="sm-check">
          <input autocomplete="off" type="checkbox" name="acepto" value="si" data-casilla-aceptar />
          <% if (pedirEdad) { %>
            <span>Tengo 18 años o más y acepto los <strong>términos y condiciones</strong> y la <strong>política de privacidad</strong>.</span>
          <% } else { %>
            <span>Leí y acepto los <strong>términos y condiciones</strong> y la <strong>política de privacidad</strong>.</span>
          <% } %>
        </label>
        <div class="sm-form__acciones">
          <button type="submit" class="btn btn--verde btn--grande" data-boton-aceptar>Aceptar y continuar</button>
        </div>
      </form>

      <form autocomplete="off" action="/logout" method="POST" class="sm-form__secundaria">
        <button type="submit" class="sm-enlace">No acepto, cerrar sesión</button>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
