<%- include('partials/header') %>
<%
  // Altura de la marca en la mini cancha de cada posición (0 = arco rival, 32 = arco propio).
  const alturaPosicion = { arquero: 27, defensa: 21, mediocampista: 15, delantero: 7 };
  const hoy = new Date().toISOString().slice(0, 10);
%>

<section class="perfil editor">
  <!-- "Volver" en su propia fila: arriba a la izquierda en celular (antes quedaba centrado bajo la carta) -->
  <div class="perfil__volver"><%- include('partials/boton-volver', { fallbackUrl: '/perfil' }) %></div>
  <!-- ============ COLUMNA IZQUIERDA: VISTA PREVIA DE LA CARTA + FOTO ============ -->
  <div class="perfil__carta">
    <%- include('partials/carta-jugador', { jugador, editor: true }) %>

    <!-- La foto se guarda junto con el formulario (editar-perfil.js la envía a POST /perfil/foto) -->
    <div class="editor__foto">
      <label class="btn btn--contorno" for="foto">
        <svg class="btn__icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
        <span data-texto-subir><%= jugador.foto ? 'Cambiar foto' : 'Subir foto' %></span>
      </label>
      <button type="button" class="enlace-icono" data-quitar-foto <%= jugador.foto ? '' : 'hidden' %>>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M10 7V4.5h4V7M7 7l1 13h8l1-13" /></svg>
        Quitar foto
      </button>
    </div>
    <p class="editor__ayuda">JPG, PNG o WebP. La recortamos y comprimimos antes de guardarla.</p>
    <input type="file" id="foto" accept="image/jpeg,image/png,image/webp" class="solo-lectores" data-foto-input />
  </div>

  <!-- ============ COLUMNA DERECHA: FORMULARIO ============ -->
  <!-- Encabezado aparte: en escritorio va sobre la columna derecha y la carta queda al nivel de la primera tarjeta -->
  <header class="perfil__cabecera">
    <span class="rol__eyebrow">SEARCH MATCH · PERFIL</span>
    <h1 class="perfil__titulo">Editar perfil</h1>
    <p class="perfil__subtitulo">Los cambios se ven en tu carta al instante; se guardan al presionar “Guardar cambios”.</p>
  </header>

  <div class="perfil__info">
    <form action="/perfil/editar" method="POST" class="formulario editor__form" data-editor>
      <!-- Errores del servidor o de editar-perfil.js -->
      <div class="alerta alerta--error" role="alert" data-alerta-errores <%= errores.length > 0 ? '' : 'hidden' %>>
        <ul>
          <% errores.forEach(function (error) { %><li><%= error %></li><% }) %>
        </ul>
      </div>

      <!-- ============ DATOS PERSONALES ============ -->
      <fieldset class="perfil__tarjeta editor__seccion">
        <legend class="perfil__tarjeta-titulo">Datos personales</legend>

        <!-- PE-002: nombre y apellido también se editan aquí -->
        <div class="formulario__fila">
          <div class="campo">
            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" name="nombre" value="<%= datos.nombre || '' %>" maxlength="100"
                   autocomplete="given-name" required />
          </div>
          <div class="campo">
            <label for="apellido">Apellido</label>
            <input type="text" id="apellido" name="apellido" value="<%= datos.apellido || '' %>" maxlength="100"
                   autocomplete="family-name" required />
          </div>
        </div>

        <div class="campo">
          <label for="apodo">Apodo</label>
          <input type="text" id="apodo" name="apodo" value="<%= datos.apodo || '' %>" placeholder="Ej. El Niño Maravilla"
                 maxlength="20" autocomplete="nickname" aria-describedby="apodo-ayuda" required data-editor-apodo />
          <small class="campo__ayuda" id="apodo-ayuda">Es el nombre que aparece en tu carta.</small>
        </div>

        <div class="campo">
          <label for="fecha_nacimiento">Fecha de nacimiento</label>
          <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" value="<%= datos.fechaNacimiento || '' %>"
                 max="<%= hoy %>" autocomplete="bday" required />
        </div>

        <div class="formulario__fila">
          <div class="campo">
            <label for="altura">Altura</label>
            <div class="campo__unidad" data-unidad="cm">
              <input type="number" id="altura" name="altura" value="<%= datos.altura || '' %>"
                     inputmode="numeric" min="<%= rangos.ALTURA_CM.min %>" max="<%= rangos.ALTURA_CM.max %>" required />
            </div>
          </div>
          <div class="campo">
            <label for="peso">Peso</label>
            <div class="campo__unidad" data-unidad="kg">
              <input type="number" id="peso" name="peso" value="<%= datos.peso || '' %>"
                     inputmode="numeric" min="<%= rangos.PESO_KG.min %>" max="<%= rangos.PESO_KG.max %>" required />
            </div>
          </div>
        </div>
      </fieldset>

      <!-- ============ PERFIL DEPORTIVO ============ -->
      <fieldset class="perfil__tarjeta editor__seccion">
        <legend class="perfil__tarjeta-titulo">Perfil deportivo</legend>

        <%- include('partials/sm-posiciones', { posiciones: datos.posiciones, catalogo: catalogos.POSICIONES }) %>
      </fieldset>

      <!-- ============ ESTADÍSTICAS ============ -->
      <fieldset class="perfil__tarjeta editor__seccion">
        <legend class="perfil__tarjeta-titulo">Estadísticas</legend>
        <p class="perfil__nota editor__nota">
          Media de tu carta principal: <strong class="texto-verde" data-editor-media><%= jugador.media %></strong> ·
          ponderada según tu posición: sus estadísticas clave (en verde) valen más.
        </p>

        <!-- Deslizadores editables (1–99): editar-perfil.js actualiza el número, la carta y la media en vivo.
             Se guardan con "Guardar cambios" (POST /perfil/editar). Siempre se envían los dos grupos;
             se muestra el de portero solo si alguna de tus posiciones es Portero (y el de campo si juegas de campo). -->
        <% const posicionesActuales = datos.posiciones || [];
           const pesosPrincipal = pesos[posicionesActuales[0]] || {}; %>
        <% gruposStats.forEach(function (grupo) {
             const visible = grupo.clave === 'arquero' ? posicionesActuales.includes('arquero') : posicionesActuales.some((p) => p !== 'arquero') || !posicionesActuales.length; %>
          <div class="editor__grupo-stats" data-grupo-stats="<%= grupo.clave %>" <%= visible ? '' : 'hidden' %>>
            <h3 class="sm-posiciones__subtitulo"><%= grupo.titulo %></h3>
            <ul class="editor__stats">
              <% grupo.lista.forEach(function (s) { %>
                <li class="editor__stat<%= (pesosPrincipal[s.clave] || 0) >= 0.2 ? ' carta-jugador__stat--clave' : '' %>" data-stat-item="<%= s.clave %>">
                  <label class="editor__stat-nombre" for="stat_<%= s.clave %>">
                    <span class="barras__sigla"><%= s.sigla %></span> <%= s.nombre %>
                  </label>
                  <input class="editor__rango" type="range" id="stat_<%= s.clave %>" name="stat_<%= s.clave %>"
                         min="<%= rangos.STAT.min %>" max="<%= rangos.STAT.max %>" step="1" value="<%= s.valor %>"
                         style="--valor: <%= s.valor %>" data-editor-stat="<%= s.clave %>" data-sigla="<%= s.sigla %>" data-grupo="<%= grupo.clave %>" />
                  <output class="barras__valor" for="stat_<%= s.clave %>" data-editor-valor="<%= s.clave %>"><%= s.valor %></output>
                </li>
              <% }) %>
            </ul>
          </div>
        <% }) %>
        <script type="application/json" data-pesos><%- JSON.stringify(pesos) %></script>
      </fieldset>

      <div class="perfil__acciones">
        <button type="submit" class="btn btn--verde btn--grande" data-guardar>
          <span class="btn__spinner" aria-hidden="true"></span>
          <span class="btn__texto">Guardar cambios</span>
        </button>
        <a class="btn btn--contorno btn--grande" href="/perfil">Cancelar</a>
      </div>

      <p class="perfil__estado" role="status" aria-live="polite" data-estado></p>
    </form>

    <!-- ============ ZONA DE PELIGRO: ELIMINAR LA CUENTA ============ -->
    <!-- Formulario aparte (no se envía con "Guardar cambios"). El botón rojo despliega la confirmación:
         hay que escribir la frase exacta; el servidor la vuelve a comprobar (POST /cuenta/eliminar). -->
    <section class="perfil__tarjeta editor__peligro" aria-labelledby="titulo-eliminar" data-eliminar-cuenta>
      <h2 class="perfil__tarjeta-titulo" id="titulo-eliminar">Eliminar mi cuenta</h2>
      <p class="editor__peligro-texto">
        Se borran para siempre tu cuenta, tu carta y todas tus vinculaciones con equipos: sales de los planteles
        donde juegas y se eliminan los equipos que capitaneas, con sus desafíos y partidos. No se puede deshacer.
      </p>

      <button type="button" class="btn btn--grande editor__btn-eliminar" data-eliminar-abrir
              aria-expanded="<%= locals.errorEliminar ? 'true' : 'false' %>" aria-controls="form-eliminar"
              <%= locals.errorEliminar ? 'hidden' : '' %>>
        Eliminar mi cuenta
      </button>

      <form action="/cuenta/eliminar" method="POST" class="editor__eliminar-form" id="form-eliminar"
            data-eliminar-form <%= locals.errorEliminar ? '' : 'hidden' %>>
        <% if (locals.errorEliminar) { %><div class="alerta alerta--error" role="alert"><%= errorEliminar %></div><% } %>
        <div class="campo">
          <label for="confirmacion">Para confirmar, escribe <strong>“<%= fraseEliminar %>”</strong></label>
          <input type="text" id="confirmacion" name="confirmacion" autocomplete="off" autocapitalize="off"
                 spellcheck="false" placeholder="<%= fraseEliminar %>" required
                 data-eliminar-input data-frase="<%= fraseEliminar %>" />
        </div>
        <div class="perfil__acciones">
          <button type="submit" class="btn btn--grande editor__btn-eliminar" data-eliminar-confirmar disabled>
            Eliminar mi cuenta definitivamente
          </button>
          <button type="button" class="btn btn--contorno btn--grande" data-eliminar-cancelar>Cancelar</button>
        </div>
      </form>
    </section>
  </div>
</section>

<p class="panel-aviso" role="status" aria-live="polite" data-aviso></p>

<%- include('partials/dock', { activo: 'perfil' }) %>

<%- include('partials/footer') %>
