<%- include('partials/header') %>

<%- include('partials/cursor-luz') %>

<section class="eq">
  <div class="contenedor sm-legal">
    <header class="eq-cabecera revelar">
      <div class="eq-cabecera__texto">
        <span class="dash-chip"><span class="badge__punto" aria-hidden="true"></span>Paso 1 de 2</span>
        <h1 class="eq-cabecera__titulo">¡Bienvenido a SearchMatch!</h1>
        <p class="eq-cabecera__stats">Tu nombre, correo y foto ya vienen de Google. Solo faltan dos datos y aceptar los términos; tu posición, altura y peso los eliges después, al armar tu carta.</p>
      </div>
    </header>

    <div class="dash-panel eq-panel revelar">
      <form autocomplete="off" action="/completar-perfil" method="POST" class="sm-form" novalidate data-requiere-aceptar>
        <div class="formulario__fila">
          <div class="campo<%= errores.fecha_nacimiento ? ' campo--error' : '' %>">
            <label for="fecha_nacimiento">Fecha de nacimiento</label>
            <div class="campo__control">
              <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" value="<%= datos.fecha_nacimiento || '' %>"
                     max="<%= new Date().toISOString().slice(0, 10) %>" autocomplete="off"
                     aria-describedby="fecha_nacimiento-error fecha_nacimiento-ayuda" required />
            </div>
            <small class="campo__error" id="fecha_nacimiento-error"><%= errores.fecha_nacimiento || '' %></small>
            <small class="campo__ayuda" id="fecha_nacimiento-ayuda">SearchMatch es solo para mayores de 18 años.</small>
          </div>

          <div class="campo<%= errores.telefono ? ' campo--error' : '' %>">
            <label for="telefono">Teléfono (WhatsApp)</label>
            <div class="campo__control">
              <input type="tel" id="telefono" name="telefono" placeholder="+56 9 1234 5678" value="<%= datos.telefono || '' %>"
                     autocomplete="off" inputmode="tel" data-telefono-cl
                     aria-describedby="telefono-error telefono-ayuda" required />
            </div>
            <small class="campo__error" id="telefono-error"><%= errores.telefono || '' %></small>
            <small class="campo__ayuda" id="telefono-ayuda">Para que tu capitán te avise de los partidos.</small>
          </div>
        </div>

        <div class="campo sm-check-campo<%= errores.acepto ? ' campo--error' : '' %>">
          <label class="sm-check">
            <input autocomplete="off" type="checkbox" name="acepto" value="si" <%= datos.acepto ? 'checked' : '' %> data-casilla-aceptar />
            <span>Tengo 18 años o más y acepto los
              <a href="/terminos" target="_blank" rel="noopener">términos y condiciones</a> (v<%= terminos.version %>) y la
              <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a> (v<%= privacidad.version %>).</span>
          </label>
          <small class="campo__error"><%= errores.acepto || '' %></small>
          <small class="campo__ayuda" data-aviso-aceptar>Marca la casilla para continuar.</small>
        </div>

        <div class="sm-form__acciones">
          <button type="submit" class="btn btn--verde btn--grande" data-boton-aceptar>Continuar a mi carta →</button>
        </div>
      </form>

      <form autocomplete="off" action="/logout" method="POST" class="sm-form__secundaria">
        <button type="submit" class="sm-enlace">Ahora no, cerrar sesión</button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
