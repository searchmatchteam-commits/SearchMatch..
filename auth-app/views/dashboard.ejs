<%- include('partials/header') %>

<section class="auth">
  <div class="tarjeta auth__tarjeta auth__tarjeta--ancha dashboard">
    <span class="badge"><span class="badge__punto" aria-hidden="true"></span>Sesión activa</span>
    <h1 class="auth__titulo">¡Hola, <span class="texto-verde"><%= usuario.nombre %></span>!</h1>
    <p class="auth__subtitulo">
      Bienvenido a SearchMatch. Muy pronto aquí verás tus partidos, equipos y reservas.
    </p>

    <dl class="dashboard__datos">
      <div>
        <dt>Nombre</dt>
        <dd><%= usuario.nombre %> <%= usuario.apellido %></dd>
      </div>
      <div>
        <dt>Correo</dt>
        <dd><%= usuario.correo %></dd>
      </div>
    </dl>

    <form action="/logout" method="POST">
      <button type="submit" class="btn btn--contorno btn--grande">Cerrar sesión</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
