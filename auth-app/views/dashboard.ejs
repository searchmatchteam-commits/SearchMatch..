<%- include('partials/header') %>

<!-- ============ SALUDO ============ -->
<section class="panel-hero">
  <div class="contenedor panel-hero__grid">
    <div class="panel-hero__texto">
      <span class="badge"><span class="badge__punto" aria-hidden="true"></span>Sesión activa</span>

      <!-- El nombre se trunca con "..." si no cabe; el title muestra el nombre completo -->
      <h1 class="panel-hero__titulo">
        <span class="panel-hero__saludo">¡Hola,</span>
        <span class="panel-hero__nombre texto-verde" title="<%= usuario.nombre %>"><%= usuario.nombre %>!</span>
      </h1>
      <p class="panel-hero__parrafo">¿Listo para tu próxima pichanga? Encuentra cupos cerca de ti, reserva cancha y súmate a un equipo.</p>

      <% if (carta) { %>
        <a class="panel-hero__carta" href="/perfil" aria-label="Tu carta: media <%= carta.media %>, <%= carta.posicion %>, nivel <%= carta.nivel %>">
          <span class="panel-hero__media"><%= carta.media %></span>
          <span class="panel-hero__carta-texto">
            <span class="panel-hero__carta-titulo">Tu carta</span>
            <span><%= carta.posicion %> · <%= carta.nivel %></span>
          </span>
          <span class="panel-hero__carta-flecha" aria-hidden="true">→</span>
        </a>
      <% } %>

      <div class="panel-hero__acciones">
        <a class="btn btn--verde btn--xl btn--glow panel-hero__cta" href="#canchas">
          <svg class="btn__icono" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
          Buscar partido
        </a>
        <% if (usuario.rolInicio === 'equipo') { %>
          <a class="btn btn--contorno btn--grande" href="/registro-equipo">Mi equipo</a>
        <% } else if (carta) { %>
          <a class="btn btn--contorno btn--grande" href="/perfil">Ver mi carta</a>
        <% } else { %>
          <a class="btn btn--contorno btn--grande" href="/perfil-jugador">Crear mi carta</a>
        <% } %>
      </div>
    </div>

    <!-- Escritorio: a la derecha. Celular: fondo tenue detrás del saludo (ver style.css). -->
    <div class="panel-hero__visual">
      <div class="ball-stage">
        <div class="ball-cuadricula" aria-hidden="true"></div>
        <div class="ball-foco" aria-hidden="true"></div>
        <div class="ball-anillo" aria-hidden="true"></div>
        <div class="ball-fallback" aria-hidden="true"></div>
        <div id="ball-canvas" role="img" aria-label="Balón de fútbol 3D interactivo"></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ CANCHAS Y EQUIPOS ============ -->
<div class="contenedor contenedor--amplio panel-grid">
  <section class="panel-seccion" id="canchas" aria-labelledby="canchas-titulo">
    <header class="panel-seccion__cabecera">
      <h2 class="panel-seccion__titulo" id="canchas-titulo">Canchas disponibles</h2>
      <span class="chip panel-seccion__chip">Ejemplo</span>
    </header>

    <ul class="panel-lista">
      <% canchas.forEach(function (cancha) { %>
        <li class="panel-item">
          <span class="panel-item__icono" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M12 5v14" /><circle cx="12" cy="12" r="2.6" /></svg>
          </span>
          <div class="panel-item__info">
            <h3 class="panel-item__titulo"><%= cancha.nombre %></h3>
            <p class="panel-item__meta"><%= cancha.comuna %> · <%= cancha.tipo %></p>
            <p class="panel-item__meta panel-item__meta--destacada"><%= cancha.horario %></p>
          </div>
          <div class="panel-item__acciones">
            <span class="panel-item__precio"><%= cancha.precio %><small>/hora</small></span>
            <button type="button" class="btn btn--verde btn--chico" data-proximamente="Muy pronto podrás reservar <%= cancha.nombre %> desde aquí.">Reservar</button>
          </div>
        </li>
      <% }) %>
    </ul>
  </section>

  <section class="panel-seccion" id="equipos" aria-labelledby="equipos-titulo">
    <header class="panel-seccion__cabecera">
      <h2 class="panel-seccion__titulo" id="equipos-titulo">Equipos disponibles</h2>
      <span class="chip panel-seccion__chip">Ejemplo</span>
    </header>

    <ul class="panel-lista">
      <% equipos.forEach(function (equipo) { %>
        <li class="panel-item">
          <span class="panel-item__escudo" style="--tono: <%= equipo.tono %>" aria-hidden="true"><%= equipo.iniciales %></span>
          <div class="panel-item__info">
            <h3 class="panel-item__titulo"><%= equipo.nombre %></h3>
            <p class="panel-item__meta"><%= equipo.comuna %> · <%= equipo.modalidad %> · <%= equipo.nivel %></p>
            <p class="panel-item__meta panel-item__meta--destacada">Busca: <%= equipo.busca.join(', ') %></p>
          </div>
          <div class="panel-item__acciones">
            <button type="button" class="btn btn--contorno btn--chico" data-proximamente="Muy pronto podrás enviar solicitudes a <%= equipo.nombre %>.">Enviar solicitud</button>
          </div>
        </li>
      <% }) %>
    </ul>
  </section>

  <!-- dashboard.js escribe aquí el aviso de "próximamente" -->
  <p class="panel-aviso" role="status" aria-live="polite" data-aviso></p>
</div>

<%- include('partials/dock', { activo: 'inicio' }) %>

<%- include('partials/footer') %>
