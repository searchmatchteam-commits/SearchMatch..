<%- include('partials/header') %>

<%- include('partials/fondo-cyber', { variante: 'perspectiva' }) %>

<!-- ============ HERO ============ -->
<section class="dash-hero" data-parallax>
  <div class="contenedor dash-hero__grid">
    <div class="dash-hero__texto">
      <span class="dash-chip revelar"><span class="badge__punto" aria-hidden="true"></span>Sesión activa</span>

      <!-- El nombre se trunca con "..." si no cabe; el title muestra el nombre completo -->
      <h1 class="dash-hero__titulo revelar">
        <span class="dash-hero__saludo">Bienvenido de vuelta,</span>
        <span class="dash-hero__nombre" title="<%= usuario.nombre %>"><%= usuario.nombre %></span>
      </h1>
      <p class="dash-hero__parrafo revelar">¿Listo para tu próxima pichanga? Encuentra cupos cerca de ti, reserva cancha y súmate a un equipo.</p>

      <div class="dash-hero__acciones revelar">
        <!-- Pantalla de matchmaking (solo capitanes; a los demás /matchmaking les explica por qué).
             Se mantiene presionado para activarlo (dashboard.js, sección "Mantener para buscar"); sin JS es un enlace normal. -->
        <a class="dash-cta" data-ripple="claro" href="/matchmaking" data-mantener draggable="false" aria-describedby="dash-cta-ayuda">
          <span class="dash-cta__halo" aria-hidden="true"></span>
          <svg class="dash-cta__progreso" aria-hidden="true"><rect /></svg>
          <span class="dash-cta__contenido">
            <svg class="dash-cta__icono" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
            <!-- Los tres textos ocupan la misma celda: el botón no cambia de ancho al alternarlos -->
            <span class="dash-cta__textos">
              <span class="dash-cta__texto dash-cta__texto--reposo">Buscar partido</span>
              <span class="dash-cta__texto dash-cta__texto--cargando" aria-hidden="true">Mantén presionado...</span>
              <span class="dash-cta__texto dash-cta__texto--completo" aria-hidden="true">¡Buscando!</span>
            </span>
          </span>
        </a>
        <span class="solo-lectores" id="dash-cta-ayuda">Mantén presionado para buscar partido.</span>
        <% if (usuario.rolInicio === 'equipo') { %>
          <% if (miEquipo) { %>
            <a class="dash-btn-vidrio" data-ripple href="/mi-equipo"><%= miEquipo.nombre ? 'Ir a ' + miEquipo.nombre : 'Ir a mi equipo' %></a>
          <% } else { %>
            <a class="dash-btn-vidrio" data-ripple href="/crear-equipo">Crear mi equipo</a>
          <% } %>
        <% } else if (carta) { %>
          <a class="dash-btn-vidrio" data-ripple href="/perfil">Ver mi carta</a>
        <% } else { %>
          <a class="dash-btn-vidrio" data-ripple href="/perfil-jugador">Crear mi carta</a>
        <% } %>
      </div>

      <% if (carta) { %>
        <a class="dash-resumen revelar" href="/perfil" aria-label="Tu carta: media <%= carta.media %>, <%= carta.posicion %>">
          <span class="dash-resumen__media"><%= carta.media %></span>
          <span class="dash-resumen__texto">
            <span class="dash-resumen__titulo">Tu carta</span>
            <span><%= carta.posicion %></span>
          </span>
          <span class="dash-resumen__flecha" aria-hidden="true">→</span>
        </a>
      <% } %>
    </div>

    <!-- Escritorio: a la derecha con parallax. Celular: fondo tenue detrás del saludo. -->
    <div class="dash-hero__visual">
      <div class="dash-capa dash-capa--fondo" data-profundidad="-12" aria-hidden="true">
        <span class="dash-orbita dash-orbita--1"></span>
        <span class="dash-orbita dash-orbita--2"></span>
      </div>
      <div class="dash-capa dash-capa--particulas" data-profundidad="28" aria-hidden="true">
        <% for (let i = 0; i < 14; i++) { %><span class="dash-particula" style="--i: <%= i %>"></span><% } %>
      </div>
      <div class="dash-capa dash-capa--balon" data-profundidad="10">
        <div class="ball-stage">
          <div class="ball-cuadricula" aria-hidden="true"></div>
          <div class="ball-anillo" aria-hidden="true"></div>
          <div class="ball-fallback" aria-hidden="true"></div>
          <div id="ball-canvas" role="img" aria-label="Balón de fútbol 3D interactivo"></div>
          <!-- ball.js muestra aquí la velocidad de cada remate -->
          <div class="ball-hud" aria-live="polite">
            <span class="ball-hud-titulo">Remate</span>
            <span class="ball-hud-cifra"><span class="ball-hud-vel">0</span><small>km/h</small></span>
            <span class="ball-hud-pie">Récord <span class="ball-hud-record">0</span> km/h</span>
          </div>
        </div>
      </div>
      <p class="dash-hero__pista">Arrastra para girar · toca para rematar</p>
    </div>
  </div>
</section>

<!-- ============ PANELES ============ -->
<section class="dash-paneles">
  <div class="contenedor dash-paneles__grid">

    <!-- Invitaciones de capitanes (invitacion_equipo): solo si hay pendientes. Aceptar/Rechazar son
         formularios: al volver, "Mis equipos" ya muestra el equipo nuevo (equipoController.responderInvitacion). -->
    <% if (invitaciones.length > 0) { %>
      <article class="dash-panel dash-panel--invitaciones revelar" aria-labelledby="dash-invitaciones-titulo">
        <header class="dash-panel__cabecera">
          <h2 class="dash-panel__titulo" id="dash-invitaciones-titulo">Invitaciones</h2>
          <span class="dash-etiqueta"><%= invitaciones.length %> <%= invitaciones.length === 1 ? 'nueva' : 'nuevas' %></span>
        </header>
        <ul class="dash-invitaciones">
          <% invitaciones.forEach(function (invitacion) { %>
            <li class="dash-invitacion">
              <span class="dash-equipo__escudo" aria-hidden="true"><%- include('partials/escudo-equipo', { equipo: invitacion.equipo }) %></span>
              <span class="dash-invitacion__texto">
                <span class="dash-equipo__nombre"><%= invitacion.equipo.nombre %> te invitó a su equipo</span>
                <span class="dash-equipo__meta">
                  <%= invitacion.capitan ? 'Capitán: ' + invitacion.capitan : 'Sin capitán' %><%= invitacion.equipo.detalle ? ' · ' + invitacion.equipo.detalle : '' %>
                </span>
                <% if (invitacion.fecha) { %>
                  <!-- PE-023: fecha de la invitación (fecha_invitacion es TIMESTAMPTZ: se muestra en hora de Chile) -->
                  <time class="dash-equipo__meta" datetime="<%= new Date(invitacion.fecha).toISOString() %>">Recibida el <%= new Intl.DateTimeFormat('es-CL', { timeZone: 'America/Santiago', dateStyle: 'long', timeStyle: 'short' }).format(new Date(invitacion.fecha)) %></time>
                <% } %>
              </span>
              <span class="dash-invitacion__acciones">
                <form action="/invitaciones/<%= invitacion.id %>/aceptar" method="POST">
                  <button type="submit" class="btn btn--verde btn--chico">Aceptar</button>
                </form>
                <form action="/invitaciones/<%= invitacion.id %>/rechazar" method="POST">
                  <button type="submit" class="btn btn--contorno btn--chico">Rechazar</button>
                </form>
              </span>
            </li>
          <% }) %>
        </ul>
      </article>
    <% } %>

    <!-- NUEVO: IN-005 — equipo elegido, su nivel y su próximo partido -->
    <%- include('partials/sm-equipo-inicio', { equipoInicio: locals.equipoInicio }) %>

    <!-- Carta de jugador con foil holográfico -->
    <article class="dash-panel dash-panel--carta revelar">
      <header class="dash-panel__cabecera">
        <h2 class="dash-panel__titulo">Personaliza tu perfil</h2>
        <% if (carta) { %><a class="dash-panel__enlace" href="/perfil">Ver completa →</a><% } %>
      </header>

      <% if (carta) { %>
        <!-- Silueta a escala con la altura y el peso del perfil (sin dato: 178 cm y 72 kg) -->
        <%- include('partials/visualizador-corporal', { altura: carta.altura, peso: carta.peso }) %>

        <!-- A la derecha: altura, peso y estadísticas -->
        <div class="dash-fisico">
          <dl class="dash-medidas">
            <div><dt>Altura</dt><dd><%= carta.altura ? Math.round(carta.altura) + ' cm' : '—' %></dd></div>
            <div><dt>Peso</dt><dd><%= carta.peso ? Math.round(carta.peso) + ' kg' : '—' %></dd></div>
          </dl>
          <ul class="dash-stats">
            <% carta.stats.forEach(function (stat) { %>
              <li class="dash-stat" title="<%= stat.nombre %>">
                <span class="dash-stat__sigla"><%= stat.sigla %></span>
                <span class="dash-stat__barra"><span class="dash-stat__relleno" style="--valor: <%= stat.valor %>"></span></span>
                <span class="dash-stat__valor"><%= stat.valor %></span>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } else { %>
        <div class="dash-vacio">
          <p class="dash-vacio__texto">
            <% if (usuario.rolInicio !== 'equipo') { %>
              Completa tu perfil y recibe tu carta con media y estadísticas.
            <% } else if (miEquipo && miEquipo.nombre) { %>
              Tu equipo <strong class="texto-verde"><%= miEquipo.nombre %></strong> te espera: revisa el plantel y las solicitudes.
            <% } else if (miEquipo) { %>
              Revisa el plantel y las solicitudes de tu equipo.
            <% } else { %>
              Las cartas son para jugadores. Arma tu equipo y recluta a los mejores.
            <% } %>
          </p>
          <% if (usuario.rolInicio === 'equipo') { %>
            <a class="dash-btn-vidrio" data-ripple href="<%= miEquipo ? '/mi-equipo' : '/crear-equipo' %>">
              <%= miEquipo ? 'Ir a mi equipo' : 'Crear mi equipo' %>
            </a>
          <% } else { %>
            <a class="dash-btn-vidrio" data-ripple href="/perfil-jugador">Crear mi carta</a>
          <% } %>
        </div>
      <% } %>
    </article>

    <!-- Próximos partidos: aún sin backend, muestra un skeleton con aviso -->
    <article class="dash-panel dash-panel--partidos revelar">
      <header class="dash-panel__cabecera">
        <h2 class="dash-panel__titulo">Partidos cerca de ti</h2>
        <span class="dash-etiqueta">Próximamente</span>
      </header>
      <ul class="dash-skeletons" aria-hidden="true">
        <% for (let i = 0; i < 3; i++) { %>
          <li class="dash-skeleton">
            <span class="skeleton skeleton--circulo"></span>
            <span class="dash-skeleton__lineas">
              <span class="skeleton skeleton--linea"></span>
              <span class="skeleton skeleton--linea skeleton--corta"></span>
            </span>
            <span class="skeleton skeleton--pildora"></span>
          </li>
        <% } %>
      </ul>
      <p class="dash-panel__nota">Estamos preparando la búsqueda de partidos por comuna y horario.</p>
    </article>

    <!-- Calendario del mes con eventos (el mismo de /agenda) -->
    <%- include('partials/calendario-eventos') %>

    <!-- Mis equipos: cada equipo se despliega con su plantel; en los que creó, "Administrar" -->
    <article class="dash-panel dash-panel--equipos revelar">
      <header class="dash-panel__cabecera">
        <h2 class="dash-panel__titulo">Mis equipos</h2>
        <a class="dash-tequipos__buscar" href="/equipos">Buscar equipos</a>
      </header>

      <%- include('partials/mis-equipos', { misEquipos, volver: '/dashboard' }) %>
    </article>
  </div>
</section>

<!-- Aviso tras responder una invitación (dashboard.js lo esconde); también escribe aquí los de "próximamente" -->
<p class="panel-aviso <%= aviso ? 'panel-aviso--visible' : '' %>" role="status" aria-live="polite" data-aviso><%= aviso || '' %></p>

<%- include('partials/dock', { activo: 'inicio' }) %>

<%- include('partials/footer') %>
