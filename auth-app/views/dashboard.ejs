<%- include('partials/header') %>

<section class="tarjeta tarjeta--ancho">
  <h1 class="tarjeta__titulo">Dashboard</h1>
  <p class="dashboard__bienvenida">
    Bienvenido, <strong><%= usuario.nombre %></strong>. 🎉
  </p>

  <div class="dashboard__datos">
    <p><span class="etiqueta">ID:</span> <%= usuario.id %></p>
    <p><span class="etiqueta">Nombre:</span> <%= usuario.nombre %></p>
    <p><span class="etiqueta">Email:</span> <%= usuario.email %></p>
  </div>

  <div class="dashboard__nota">
    <p>
      Esta es una <strong>ruta protegida</strong>: solo es visible porque tu
      sesión está activa en el servidor (cookie firmada por express-session).
    </p>
  </div>

  <form action="/logout" method="POST">
    <button type="submit" class="btn btn--salir">Cerrar sesión</button>
  </form>
</section>

<%- include('partials/footer') %>
