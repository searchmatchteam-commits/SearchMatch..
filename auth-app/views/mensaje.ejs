<%- include('partials/header') %>

<%- include('partials/fondo-cyber', { variante: 'perspectiva' }) %>

<!-- Mensaje genérico para elementos que ya no existen o sin permiso (NT-004, DE-014, AG-002...).
     Uso: res.render('mensaje', { titulo, pagina: 'equipo', mensaje, enlace: { href, texto } }) -->
<section class="eq">
  <div class="contenedor sm-angosto">
    <div class="dash-panel eq-panel sm-vacio">
      <p class="sm-vacio__titulo"><%= titulo %></p>
      <p class="dash-panel__nota"><%= mensaje %></p>
      <a class="btn btn--verde" href="<%= enlace.href %>"><%= enlace.texto %></a>
    </div>
  </div>
</section>

<% if (usuario) { %><%- include('partials/dock', { activo: '' }) %><% } %>

<%- include('partials/footer') %>
