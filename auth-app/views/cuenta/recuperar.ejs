<%- include('../partials/header') %>

<%- include('../partials/fondo-cyber', { variante: 'pizarra' }) %>

<section class="auth auth--login">
  <%- include('../partials/auth-marca', { titulo: 'Vuelve a la <em>cancha</em>.' }) %>

  <div class="tarjeta auth__tarjeta">
    <span class="auth__filo" aria-hidden="true"></span>

    <span class="etiqueta-verde">Recuperar acceso</span>
    <h1 class="auth__titulo">¿Olvidaste tu contraseña?</h1>
    <p class="auth__subtitulo">Escribe el correo de tu cuenta (principal o secundario) y te enviaremos un enlace para crear una nueva.</p>

    <% if (aviso) { %>
      <div class="alerta alerta--error" role="alert"><%= aviso %></div>
    <% } %>

    <% if (enviado) { %>
      <div class="alerta alerta--exito" role="status"><%= mensajeEnviado %></div>
      <p class="auth__pie">¿No llegó? Espera unos minutos y <a href="/recuperar">pide otro enlace</a>.</p>
    <% } else { %>
      <form action="/recuperar" method="POST" class="formulario sm-form" novalidate data-sm-validar>
        <div class="campo <%= erroresCampo.correo ? 'campo--error' : '' %>">
          <label for="correo">Correo</label>
          <div class="campo__control">
            <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
            <input type="email" id="correo" name="correo" placeholder="tucorreo@ejemplo.com" value="<%= datos.correo || '' %>"
                   autocomplete="email" maxlength="150" aria-describedby="correo-error" required
                   data-mensaje="Escribe el correo de tu cuenta." />
          </div>
          <small class="campo__error" id="correo-error"><%= erroresCampo.correo || '' %></small>
        </div>

        <button type="submit" class="btn btn--verde btn--bloque btn--grande auth-btn" data-ripple="claro">
          <span class="auth-btn__halo" aria-hidden="true"></span>
          <span class="btn__texto">ENVIAR ENLACE</span>
          <span class="btn__flecha" aria-hidden="true">→</span>
        </button>
      </form>
    <% } %>

    <p class="auth__pie">¿Te acordaste? <a href="/login">Inicia sesión</a></p>
  </div>
</section>

<script>
  // AP-011: algunas plantillas de Supabase (invitación de administrador) dejan los tokens en el fragmento
  // (#access_token=...), que el servidor no ve. Se reenvían como parámetros para validarlos en el servidor.
  (function () {
    var datos = new URLSearchParams(location.hash.slice(1));
    if (datos.get('access_token') && datos.get('refresh_token')) {
      location.replace('/recuperar/nueva?' + new URLSearchParams({
        access_token: datos.get('access_token'), refresh_token: datos.get('refresh_token'), type: datos.get('type') || '',
      }).toString());
    }
  })();
</script>

<%- include('../partials/footer') %>
