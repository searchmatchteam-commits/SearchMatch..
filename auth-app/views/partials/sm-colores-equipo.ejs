<%#
  Colores del equipo (config/coloresEquipo.js): los dos de su carta y sus dos camisetas.
  Lo usan crear-equipo, equipos/editar y el paso "Crear equipo" del wizard de jugador.
  Parámetros: colores ({ color_primario, color_secundario, camiseta_local, camiseta_visita }); si falta, los predeterminados.
  conCamisetas: true para mostrar también las dos camisetas (editar equipo). Al crear un equipo solo se piden sus
  dos colores y las camisetas se asumen iguales (config/coloresEquipo.js, camisetasPorDefecto).
  La vista previa se actualiza mientras se eligen (sm-formularios.js, [data-colores-equipo]).
%>
<%
  const predeterminados = { color_primario: '#16a34a', color_secundario: '#ffffff', camiseta_local: '#16a34a', camiseta_visita: '#ffffff' };
  const valores = Object.assign({}, predeterminados, locals.colores || {});
  Object.keys(predeterminados).forEach((campo) => { if (!/^#[0-9a-f]{6}$/.test(valores[campo] || '')) valores[campo] = predeterminados[campo]; });
  const conCamisetas = Boolean(locals.conCamisetas);
  const PALETA = locals.paletaColores || []; // app.locals (config/coloresEquipo.js)
  const camiseta = 'M8 2 3 5l2 5 2-1v13h10V9l2 1 2-5-5-3c-.5 1.7-2 3-4 3S8.5 3.7 8 2z';
%>
<fieldset class="sm-colores" data-colores-equipo
          style="--c1:<%= valores.color_primario %>;--c2:<%= valores.color_secundario %>;--cl:<%= valores.camiseta_local %>;--cv:<%= valores.camiseta_visita %>">
  <legend class="sm-colores__titulo">Colores del equipo</legend>
  <% if (conCamisetas) { %>
    <p class="campo__ayuda">Los colores personalizan la carta de tu equipo. Las dos camisetas sirven para elegir la equipación de cada partido y que nunca juegues con el mismo color que el rival.</p>
  <% } else { %>
    <p class="campo__ayuda">Personalizan la carta y el escudo de tu equipo. Tu camiseta será de estos mismos colores; si usan otra, la cambias al editar el equipo o al desafiar.</p>
  <% } %>

  <div class="sm-colores__vista" aria-hidden="true">
    <span class="sm-colores__carta"><span class="sm-colores__franja"></span></span>
    <% if (conCamisetas) { %>
      <svg class="sm-colores__camiseta sm-colores__camiseta--local" viewBox="0 0 24 24"><path d="<%= camiseta %>" /></svg>
      <svg class="sm-colores__camiseta sm-colores__camiseta--visita" viewBox="0 0 24 24"><path d="<%= camiseta %>" /></svg>
    <% } %>
  </div>

  <% [['color_primario', 'Color principal', '--c1'], ['color_secundario', 'Color secundario', '--c2']].forEach(function ([campo, etiqueta, variable]) {
       const enPaleta = PALETA.some(function (c) { return c.valor === valores[campo]; }); %>
    <div class="sm-paleta" role="group" aria-label="<%= etiqueta %>" data-paleta>
      <span class="sm-paleta__titulo"><%= etiqueta %></span>
      <div class="sm-paleta__opciones">
        <% PALETA.forEach(function (c) { %>
          <button type="button" class="sm-paleta__color" style="--muestra:<%= c.valor %>" data-color="<%= c.valor %>"
                  aria-pressed="<%= valores[campo] === c.valor %>" title="<%= c.nombre %>"><span class="solo-lectores"><%= c.nombre %></span></button>
        <% }) %>
        <!-- Otro color: el selector libre del sistema (también funciona sin JavaScript) -->
        <label class="sm-paleta__otro <%= enPaleta ? '' : 'sm-paleta__otro--activo' %>" title="Otro color">
          <input autocomplete="off" type="color" name="<%= campo %>" value="<%= valores[campo] %>" data-var="<%= variable %>" aria-label="<%= etiqueta %>: otro color" />
          <span aria-hidden="true">Otro</span>
        </label>
      </div>
    </div>
  <% }) %>

  <div class="sm-colores__grilla">
    <% if (conCamisetas) { %>
      <label class="sm-colores__campo"><input autocomplete="off" type="color" name="camiseta_local" value="<%= valores.camiseta_local %>" data-var="--cl" /> Camiseta de local</label>
      <label class="sm-colores__campo"><input autocomplete="off" type="color" name="camiseta_visita" value="<%= valores.camiseta_visita %>" data-var="--cv" /> Camiseta de visita</label>
    <% } %>
  </div>
</fieldset>
