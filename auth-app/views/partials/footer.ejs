  </main>

  <footer class="pie">
    <div class="pie__interior">
      <% if (!(usuario && usuario.esSuperAdmin)) { %>
      <!-- El superadministrador no ve estos enlaces: navega con el botón "Panel" del encabezado -->
      <nav class="pie__links" aria-label="Pie de página">
        <a href="/">Inicio</a>
        <% if (usuario) { %>
          <span aria-hidden="true">·</span>
          <a href="/dashboard">Mi panel</a>
          <span aria-hidden="true">·</span>
          <a href="/perfil/editar">Editar mi perfil</a>
          <span aria-hidden="true">·</span>
          <a href="/cuenta">Mi cuenta</a>
        <% } else { %>
          <span aria-hidden="true">·</span>
          <a href="/login">Iniciar sesión</a>
          <span aria-hidden="true">·</span>
          <a href="/registro">Registrarse</a>
        <% } %>
        <span aria-hidden="true">·</span>
        <a href="/terminos">Términos</a>
        <span aria-hidden="true">·</span>
        <a href="/privacidad">Privacidad</a>
      </nav>
      <% } %>
      <p class="pie__copy">&copy; <%= new Date().getFullYear() %> SearchMatch · Fútbol amateur en Chile</p>
    </div>
  </footer>

  <script src="/js/main.js?v=<%= versionAssets %>" defer></script>
  <script src="/js/sm-formularios.js?v=<%= versionAssets %>" defer></script>
  <% if (locals.pagina === 'dashboard' || locals.pagina === 'auth' || locals.pagina === 'equipo') { %>
    <script src="/js/cyber.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'auth') { %>
    <script src="/js/auth.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'rol') { %>
    <script src="/js/rol.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'wizard' && locals.wizardEquipo) { %>
    <script src="/js/crear-equipo.js?v=<%= versionAssets %>" defer></script>
  <% } else if (locals.pagina === 'wizard') { %>
    <script src="/js/wizard.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'perfil' && locals.editorPerfil) { %>
    <script src="/js/editar-perfil.js?v=<%= versionAssets %>" defer></script>
  <% } else if (locals.pagina === 'perfil' && !locals.perfilAjeno) { %>
    <script src="/js/perfil.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.perfilPro) { %>
    <!-- /perfil: partículas del fondo, caída de la carta, conteo de números y radar -->
    <script src="/js/perfil-pro.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'landing' || locals.pagina === 'dashboard') { %>
    <script type="module" src="/js/ball.js?v=<%= versionAssets %>"></script>
  <% } %>
  <% if (locals.pagina === 'dashboard' || locals.pagina === 'equipo' || locals.pagina === 'perfil') { %>
    <script src="/js/dashboard.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'dashboard') { %>
    <script src="/js/visualizador-corporal.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'dashboard' || locals.calendarioEventos) { %>
    <!-- Calendario del mes con eventos (dashboard y /agenda: partials/calendario-eventos) -->
    <script src="/js/calendario.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'equipo') { %>
    <script src="/js/equipo.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.torneoLista) { %>
    <script src="/js/torneos-lista.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.torneoDetalle) { %>
    <script src="/js/torneo-detalle.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.torneoForm) { %>
    <script src="/js/torneo-form.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (!usuario) { %>
    <script type="speculationrules">
      { "prerender": [{ "where": { "href_matches": ["/login", "/registro"] }, "eagerness": "moderate" }] }
    </script>
  <% } %>
</body>
</html>
