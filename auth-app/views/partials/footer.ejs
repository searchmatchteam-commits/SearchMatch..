  </main>

  <footer class="pie">
    <div class="pie__interior">
      <nav class="pie__links" aria-label="Pie de página">
        <a href="/">Inicio</a>
        <% if (usuario) { %>
          <span aria-hidden="true">·</span>
          <a href="/dashboard">Mi panel</a>
          <span aria-hidden="true">·</span>
          <a href="/perfil-jugador">Editar mi perfil</a>
        <% } else { %>
          <span aria-hidden="true">·</span>
          <a href="/login">Iniciar sesión</a>
          <span aria-hidden="true">·</span>
          <a href="/registro">Registrarse</a>
        <% } %>
      </nav>
      <p class="pie__copy">&copy; <%= new Date().getFullYear() %> SearchMatch · Fútbol amateur en Chile</p>
    </div>
  </footer>

  <script src="/js/main.js?v=<%= versionAssets %>" defer></script>
  <% if (locals.pagina === 'dashboard' || locals.pagina === 'auth' || locals.pagina === 'equipo') { %>
    <!-- Ripple y cursor de luz del sistema "cyber-sport" -->
    <script src="/js/cyber.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'auth') { %>
    <!-- Validación y estado "cargando" de login/registro -->
    <script src="/js/auth.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'rol') { %>
    <!-- Selección de rol: texto y estado del botón -->
    <script src="/js/rol.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'wizard' && locals.wizardEquipo) { %>
    <!-- Wizard de equipo: pasos, validación y vista previa del club -->
    <script src="/js/crear-equipo.js?v=<%= versionAssets %>" defer></script>
  <% } else if (locals.pagina === 'wizard') { %>
    <!-- Wizard de perfil: pasos, validación y resumen -->
    <script src="/js/wizard.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'perfil') { %>
    <!-- Carta: vista previa de la foto, descargar y compartir -->
    <script src="/js/perfil.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'landing' || locals.pagina === 'dashboard') { %>
    <!-- Balón 3D: Three.js se carga desde CDN dentro de ball.js -->
    <script type="module" src="/js/ball.js?v=<%= versionAssets %>"></script>
  <% } %>
  <% if (locals.pagina === 'dashboard' || locals.pagina === 'equipo') { %>
    <!-- Dashboard: avisos de "próximamente", parallax y foil de la carta -->
    <script src="/js/dashboard.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (locals.pagina === 'equipo') { %>
    <!-- Panel del capitán: solicitudes y plantel (datos de prueba) -->
    <script src="/js/equipo.js?v=<%= versionAssets %>" defer></script>
  <% } %>
  <% if (!usuario) { %>
    <!-- Prerender: al pasar el mouse (o tocar) un enlace a login/registro, Chrome y Edge
         preparan esa página en segundo plano y al hacer clic aparece al instante.
         Los navegadores que no lo soportan simplemente lo ignoran. -->
    <script type="speculationrules">
      { "prerender": [{ "where": { "href_matches": ["/login", "/registro"] }, "eagerness": "moderate" }] }
    </script>
  <% } %>
</body>
</html>
