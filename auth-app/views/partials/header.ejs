<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= titulo %> | SearchMatch</title>
  <meta name="description" content="SearchMatch conecta jugadores, equipos y canchas de fútbol amateur en Chile." />
  <meta name="theme-color" content="#0b0d0b" />
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<%
    const cyber = locals.pagina === 'dashboard' || locals.pagina === 'auth' || locals.pagina === 'equipo';
    const fuentes = 'family=Inter:wght@400;500;600;700;800;900' + (cyber ? '&family=Space+Grotesk:wght@500;600;700' : '')
      + (locals.pagina === 'perfil' || locals.pagina === 'dashboard' ? '&family=Barlow+Condensed:wght@600;700;800' : '');
  %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?<%= fuentes %>&display=swap" />
  <link rel="stylesheet" href="/css/style.css?v=<%= versionAssets %>" />
  <link rel="stylesheet" href="/css/modulos.css?v=<%= versionAssets %>" />
  <% if (locals.wizardEquipo) { %>
    <link rel="stylesheet" href="/css/crear-equipo.css?v=<%= versionAssets %>" />
  <% } %>
  <% if (cyber) { %>
    <link rel="stylesheet" href="/css/cyber.css?v=<%= versionAssets %>" />
    <% if (pagina === 'equipo') { %>
      <link rel="stylesheet" href="/css/dashboard.css?v=<%= versionAssets %>" />
    <% } %>
    <link rel="stylesheet" href="/css/<%= pagina %>.css?v=<%= versionAssets %>" />
  <% } %>
  <% if (locals.pagina === 'perfil') { %>
    <link rel="stylesheet" href="/css/dashboard.css?v=<%= versionAssets %>" />
  <% } %>
  <% if (locals.pagina === 'landing' || locals.pagina === 'dashboard') { %>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <% } %>
  <% if (locals.pagina === 'auth') { %>
    <link rel="prefetch" href="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js" crossorigin="anonymous" />
  <% } %>
  <script>
    (function () {
      var raiz = document.documentElement;
      raiz.classList.add('js');
      try {
        var forzado = new URLSearchParams(location.search).get('liviano');
        if (forzado !== null) localStorage.setItem('sm-liviano', forzado === '0' ? 'no' : 'si');
        var modo = localStorage.getItem('sm-liviano') || (sessionStorage.getItem('sm-gpu') === 'software' ? 'si' : 'no');
        if (modo === 'si') raiz.classList.add('modo-liviano');
      } catch (e) {  }
    })();
  </script>
</head>
<body class="<%= locals.pagina ? 'pagina-' + pagina : '' %>">
  <header class="navbar">
    <div class="navbar__interior">
      <a class="logo" href="/" aria-label="SearchMatch, inicio">
        <svg class="logo__icono" viewBox="0 0 24 24" aria-hidden="true">
          <defs>
            <mask id="logo-balon">
              <circle cx="12" cy="12" r="10" fill="#fff" />
              <path d="M12 7.8 15.99 10.7 14.47 15.4 9.53 15.4 8.01 10.7Z" fill="#000" stroke="#000" stroke-width="1.1" stroke-linejoin="round" />
              <path d="M12 7.8V2M15.99 10.7l5.52-1.79M14.47 15.4l3.41 4.69M9.53 15.4l-3.41 4.69M8.01 10.7L2.49 8.91" fill="none" stroke="#000" stroke-width="1" stroke-linecap="round" />
            </mask>
          </defs>
          <circle cx="12" cy="12" r="10" fill="currentColor" mask="url(#logo-balon)" />
        </svg>
        <span class="logo__texto">SEARCHMATCH</span>
      </a>

      <nav class="navbar__nav" aria-label="Cuenta">
        <% if (usuario) { %>
          <% if (!['dashboard', 'equipo', 'perfil'].includes(locals.pagina)) { %>
            <a class="btn btn--contorno btn--chico" href="/dashboard">Mi panel</a>
          <% } %>
          <a class="sm-icono-nav" href="/agenda" title="Agenda de partidos" aria-label="Agenda de partidos">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
          </a>
          <a class="sm-icono-nav" href="/notificaciones" title="Notificaciones"
             aria-label="Notificaciones<%= locals.notificacionesSinLeer ? `, ${notificacionesSinLeer} sin leer` : '' %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z" /><path d="M10 20a2 2 0 0 0 4 0" /></svg>
            <% if (locals.notificacionesSinLeer) { %><span class="sm-icono-nav__contador"><%= notificacionesSinLeer > 99 ? '99+' : notificacionesSinLeer %></span><% } %>
          </a>
          <% if (usuario.esAdmin) { %>
            <a class="btn btn--contorno btn--chico" href="/admin">Admin</a>
          <% } %>
          <form action="/logout" method="POST" class="navbar__form">
            <button type="submit" class="btn btn--verde btn--chico">Cerrar sesión</button>
          </form>
        <% } else { %>
          <a class="btn btn--contorno btn--chico" href="/login">Iniciar sesión</a>
          <a class="btn btn--verde btn--chico" href="/registro">Registrarse</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="principal">
