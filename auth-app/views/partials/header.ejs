<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= titulo %> | SearchMatch</title>
  <meta name="description" content="SearchMatch conecta jugadores, equipos y canchas de fútbol amateur en Chile." />
  <meta name="theme-color" content="#0b0d0b" />
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
  <link rel="stylesheet" href="/css/style.css" />
  <!-- Marca que hay JS: las animaciones de aparición solo se activan si existe -->
  <script>document.documentElement.classList.add('js');</script>
</head>
<body class="<%= locals.pagina ? 'pagina-' + pagina : '' %>">
  <header class="navbar">
    <div class="navbar__interior">
      <a class="logo" href="/" aria-label="SearchMatch, inicio">
        <svg class="logo__icono" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="M12 7.2l4.1 3-1.6 4.8h-5L7.9 10.2z" fill="currentColor" />
          <path d="M12 7.2V2.3M16.1 10.2l4.6-1.5M14.5 15l2.9 4M9.5 15l-2.9 4M7.9 10.2L3.3 8.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <span class="logo__texto">SEARCHMATCH</span>
      </a>

      <nav class="navbar__nav" aria-label="Cuenta">
        <% if (usuario) { %>
          <!-- Usuario con sesión activa -->
          <a class="btn btn--contorno btn--chico" href="/dashboard">Mi panel</a>
          <form action="/logout" method="POST" class="navbar__form">
            <button type="submit" class="btn btn--verde btn--chico">Cerrar sesión</button>
          </form>
        <% } else { %>
          <!-- Sin sesión -->
          <a class="btn btn--contorno btn--chico" href="/login">Iniciar sesión</a>
          <a class="btn btn--verde btn--chico" href="/registro">Registrarse</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="principal">
