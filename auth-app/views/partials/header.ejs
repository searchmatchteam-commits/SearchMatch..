<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Red lenta (2G/3G o "ahorro de datos" del celular): sin fuentes externas, balón 3D, precargas ni mapa
       automático; también el modo liviano (sin animaciones de fondo). Va primero: lo usan los enlaces de abajo. -->
  <script>
    (function () {
      // ?datos=bajo lo fuerza (queda guardado, útil con planes de datos limitados) y ?datos=normal lo apaga.
      var preferencia = null;
      try {
        var pedido = new URLSearchParams(location.search).get('datos');
        if (pedido) localStorage.setItem('sm-datos', pedido === 'bajo' ? 'bajo' : 'normal');
        preferencia = localStorage.getItem('sm-datos');
      } catch (e) { /* sin localStorage: solo la detección automática */ }
      try {
        var c = navigator.connection;
        var lenta = c && (c.saveData || /(^|-)2g$|^3g$/.test(c.effectiveType || ''));
        if (preferencia === 'bajo' || (preferencia !== 'normal' && lenta)) document.documentElement.classList.add('red-lenta');
      } catch (e) { /* navegador sin la API: red normal */ }
    })();
  </script>
  <title><%= titulo %> | SearchMatch</title>
  <meta name="description" content="SearchMatch conecta jugadores, equipos y canchas de fútbol amateur en Chile." />
  <meta name="theme-color" content="#0b0d0b" />
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<%
    // Páginas "cyber-sport": sistema compartido + hoja propia de la página
    const cyber = locals.pagina === 'dashboard' || locals.pagina === 'auth' || locals.pagina === 'equipo';
    // Una sola petición a Google Fonts (cada hoja de fuentes extra bloquea el primer pintado)
    const fuentes = 'family=Inter:wght@400;500;600;700;800;900' + (cyber || locals.perfilPro || locals.matchmaking ? '&family=Space+Grotesk:wght@500;600;700' : '')
      + (locals.pagina === 'perfil' || locals.pagina === 'dashboard' ? '&family=Barlow+Condensed:wght@600;700;800' : '')
      // Oswald: solo el apodo dentro de la carta de jugador (perfil, editor, solicitudes y plantel)
      + (locals.pagina === 'perfil' || locals.pagina === 'equipo' ? '&family=Oswald:wght@700' : '')
      // JetBrains Mono: solo el cronómetro de /matchmaking (cifras de ancho fijo)
      + (locals.matchmaking ? '&family=JetBrains+Mono:wght@700;800' : '');
  %>
  <!-- Las fuentes no bloquean el primer pintado: se ve el texto con la fuente del sistema y cambia al llegar (display=swap) -->
  <%# Con red lenta no se aplican: se usa la fuente del sistema y no se descargan los archivos de fuente %>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?<%= fuentes %>&display=swap" onload="this.onload=null;if(!document.documentElement.classList.contains('red-lenta'))this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?<%= fuentes %>&display=swap" /></noscript>
  <!-- ?v= cambia en cada arranque del servidor: el navegador puede guardar los archivos en caché sin quedar desactualizado -->
  <link rel="stylesheet" href="/css/style.css?v=<%= versionAssets %>" />
  <!-- NUEVO: estilos de las funciones nuevas (clases sm-*, no cambia las existentes) -->
  <link rel="stylesheet" href="/css/modulos.css?v=<%= versionAssets %>" />
  <% if (locals.wizardEquipo || locals.editarEquipo) { %>
    <!-- Wizard de equipo: la base es la del wizard de jugador (style.css) -->
    <link rel="stylesheet" href="/css/crear-equipo.css?v=<%= versionAssets %>" />
  <% } %>
  <% if (cyber) { %>
    <link rel="stylesheet" href="/css/cyber.css?v=<%= versionAssets %>" />
    <% if (pagina === 'equipo') { %>
      <!-- El panel del equipo reutiliza los paneles, el aviso y el dock del dashboard -->
      <link rel="stylesheet" href="/css/dashboard.css?v=<%= versionAssets %>" />
    <% } %>
    <link rel="stylesheet" href="/css/<%= pagina %>.css?v=<%= versionAssets %>" />
  <% } %>
  <% if (locals.pagina === 'perfil') { %>
    <!-- El perfil reutiliza el dock y el aviso flotante del dashboard -->
    <link rel="stylesheet" href="/css/dashboard.css?v=<%= versionAssets %>" />
  <% } %>
  <!-- Modo claro: todas sus reglas van bajo html[data-theme="light"]; va al final para ganarle a las hojas de cada página -->
  <link rel="stylesheet" href="/css/tema-claro.css?v=<%= versionAssets %>" />
  <% if (locals.torneoLista) { %>
    <!-- /torneos: galería de cartas (después de tema-claro: trae sus reglas de modo claro) -->
    <link rel="stylesheet" href="/css/torneos-lista.css?v=<%= versionAssets %>" />
  <% } %>
  <% if (locals.torneoDetalle) { %>
    <!-- /torneos/:id: dos columnas, pestañas y cuadrante (después de tema-claro: trae sus reglas de modo claro) -->
    <link rel="stylesheet" href="/css/torneo-detalle.css?v=<%= versionAssets %>" />
  <% } %>
  <% if (locals.matchmaking) { %>
    <!-- /matchmaking: pantalla completa siempre oscura (después de tema-claro) -->
    <link rel="stylesheet" href="/css/matchmaking.css?v=<%= versionAssets %>" />
  <% } %>
  <% if (locals.perfilPro) { %>
    <!-- /perfil: escena "cyber-gamer" (después de tema-claro: también trae sus reglas de modo claro) -->
    <link rel="stylesheet" href="/css/perfil-pro.css?v=<%= versionAssets %>" />
  <% } %>
  <link rel="stylesheet" href="/css/searchmatch-background.css?v=<%= versionAssets %>" />
  <% if (locals.pagina === 'landing' || locals.pagina === 'dashboard') { %>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <% } %>
  <% if (locals.pagina === 'auth') { %>
    <!-- Mientras el usuario escribe, el navegador baja Three.js en segundo plano: al entrar al dashboard el
         balón 3D ya está en caché. Con red lenta no (son ~250 KB y el balón 3D no se usa). -->
    <script>
      if (!document.documentElement.classList.contains('red-lenta')) {
        var precarga = document.createElement('link');
        precarga.rel = 'prefetch';
        precarga.href = 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';
        precarga.crossOrigin = 'anonymous';
        document.head.appendChild(precarga);
      }
    </script>
  <% } %>
  <!-- Marca que hay JS (las animaciones de aparición solo se activan si existe) y decide el
       "modo liviano": sin efectos pesados cuando el navegador no tiene aceleración gráfica.
       ?liviano=1 lo fuerza, ?liviano=0 lo desactiva (queda guardado); "sm-gpu" lo detecta cyber.js.
       También aplica el tema guardado (localStorage "sm-tema": "light" | "dark") antes del primer pintado,
       así el modo claro no parpadea en oscuro al cargar. El oscuro es el predeterminado. -->
  <script>
    (function () {
      var raiz = document.documentElement;
      raiz.classList.add('js');
      try {
        if (localStorage.getItem('sm-tema') === 'light') {
          raiz.setAttribute('data-theme', 'light');
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#ffffff');
        }
      } catch (e) { /* sin localStorage: modo oscuro */ }
      try {
        var forzado = new URLSearchParams(location.search).get('liviano');
        if (forzado !== null) localStorage.setItem('sm-liviano', forzado === '0' ? 'no' : 'si');
        // Red lenta también activa el modo liviano (salvo que el usuario lo haya apagado con ?liviano=0)
        var modo = localStorage.getItem('sm-liviano')
          || (sessionStorage.getItem('sm-gpu') === 'software' || raiz.classList.contains('red-lenta') ? 'si' : 'no');
        if (modo === 'si') raiz.classList.add('modo-liviano');
      } catch (e) { /* sin localStorage: modo normal */ }
      // El fondo sigue donde iba al cambiar de página: la malla parte adelantada lo que lleva la pestaña abierta.
      try {
        var inicioFondo = Number(sessionStorage.getItem('sm-fondo-inicio'));
        if (!inicioFondo) sessionStorage.setItem('sm-fondo-inicio', inicioFondo = Date.now());
        raiz.style.setProperty('--sm-fondo-t', (inicioFondo - Date.now()) / 1000 + 's');
      } catch (e) { /* sin sessionStorage: la malla parte de cero */ }
    })();
  </script>
</head>
<body class="sm-con-fondo <%= locals.pagina ? 'pagina-' + pagina : '' %><%= locals.perfilPro ? ' perfil-pro' : '' %>">
  <%- include('searchmatch-background') %>
  <header class="navbar">
    <div class="navbar__interior">
      <a class="logo" href="/" aria-label="SearchMatch, inicio">
        <svg class="logo__icono" viewBox="0 0 24 24" aria-hidden="true">
          <!-- Silueta sólida del balón: disco lleno con pentágono y costuras en negativo -->
          <defs>
            <mask id="logo-balon">
              <circle cx="12" cy="12" r="10" fill="#fff" />
              <path d="M12 7.8 15.99 10.7 14.47 15.4 9.53 15.4 8.01 10.7Z" fill="#000" stroke="#000" stroke-width="1.1" stroke-linejoin="round" />
              <path d="M12 7.8V2M15.99 10.7l5.52-1.79M14.47 15.4l3.41 4.69M9.53 15.4l-3.41 4.69M8.01 10.7L2.49 8.91" fill="none" stroke="#000" stroke-width="1" stroke-linecap="round" />
            </mask>
          </defs>
          <circle cx="12" cy="12" r="10" fill="currentColor" mask="url(#logo-balon)" />
        </svg>
        <span class="logo__texto">SEARCHMATCH</span>
      </a>

      <nav class="navbar__nav" aria-label="Cuenta">
        <!-- Modo claro / oscuro (main.js). Se ve el ícono del modo al que se cambia: luna en claro, sol en oscuro -->
        <button type="button" class="sm-icono-nav sm-tema" data-cambiar-tema aria-pressed="false"
                title="Cambiar a modo claro" aria-label="Cambiar a modo claro">
          <svg class="sm-tema__sol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" /></svg>
          <svg class="sm-tema__luna" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" /></svg>
        </button>
        <% if (usuario && usuario.esCuentaPanel) { %>
          <!-- AP-001: cuenta del panel. Solo su sesión del panel; salir pide confirmar y vuelve al login del panel -->
          <form action="/admin/logout" method="POST" class="navbar__form"
                data-confirmar="Volverás al ingreso del panel y sus páginas quedarán bloqueadas hasta que ingreses de nuevo."
                data-confirmar-titulo="¿Cerrar sesión del panel?" data-confirmar-boton="Cerrar sesión">
            <button type="submit" class="btn btn--verde btn--chico navbar__salir" aria-label="Cerrar sesión"><svg class="navbar__salir-icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3M16 17l5-5-5-5M21 12H9" /></svg><span class="navbar__salir-texto">Cerrar sesión</span></button>
          </form>
        <% } else if (usuario) { %>
          <!-- Usuario con sesión activa. Las páginas con dock ya llevan a Inicio desde la barra inferior -->
          <% if (!['dashboard', 'equipo', 'perfil'].includes(locals.pagina)) { %>
            <a class="btn btn--contorno btn--chico" href="/dashboard">Mi panel</a>
          <% } %>
          <% if (usuario.esAdmin) { %>
            <!-- Jugador que además es administrador: abre el panel (con su sesión, en /admin/login) -->
            <a class="sm-icono-nav" href="/admin/login" title="Panel de administrador" aria-label="Panel de administrador">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 4.4 3.4 8.3 8 9 4.6-.7 8-4.6 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg>
            </a>
          <% } %>
          <!-- NT-002/NT-003 campana con el contador de no leídas. La agenda (AG-001) está en el dock de abajo ("Calendario") -->
          <a class="sm-icono-nav" href="/notificaciones" title="Notificaciones"
             aria-label="Notificaciones<%= locals.notificacionesSinLeer ? `, ${notificacionesSinLeer} sin leer` : '' %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z" /><path d="M10 20a2 2 0 0 0 4 0" /></svg>
            <% if (locals.notificacionesSinLeer) { %><span class="sm-icono-nav__contador"><%= notificacionesSinLeer > 99 ? '99+' : notificacionesSinLeer %></span><% } %>
          </a>
          <form action="/logout" method="POST" class="navbar__form"
                data-confirmar="Tendrás que volver a iniciar sesión para entrar a tu cuenta."
                data-confirmar-titulo="¿Cerrar sesión?" data-confirmar-boton="Cerrar sesión">
            <button type="submit" class="btn btn--verde btn--chico navbar__salir" aria-label="Cerrar sesión"><svg class="navbar__salir-icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3M16 17l5-5-5-5M21 12H9" /></svg><span class="navbar__salir-texto">Cerrar sesión</span></button>
          </form>
        <% } else { %>
          <!-- Sin sesión -->
          <a class="btn btn--contorno btn--chico" href="/login">Iniciar sesión</a>
          <a class="btn btn--verde btn--chico" href="/registro">Registrarse</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="principal">
