<%
  // AP-002 · Menú lateral del panel. Las secciones vienen de config/panel.js (res.locals.seccionesPanel,
  // filtradas: "Administradores" solo para el Administrador principal). En pantallas angostas se contrae en
  // un botón "Menú" (casilla + etiqueta: funciona sin JavaScript).
  const secciones = locals.seccionesPanel || [];
  const actual = secciones.find(function (s) { return s.clave === seccion; });
%>
<input type="checkbox" id="sm-admin-menu" class="sm-admin-menu__check" />
<label for="sm-admin-menu" class="sm-admin-menu__boton">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
  <span>Menú<% if (actual) { %> · <%= actual.texto %><% } %></span>
  <% if (locals.alertasPendientes) { %><span class="sm-admin-menu__contador"><%= alertasPendientes %><span class="solo-lectores"> alertas pendientes</span></span><% } %>
</label>
<nav class="sm-admin-menu" aria-label="Secciones del panel">
  <ul class="sm-admin-menu__lista">
    <% secciones.forEach(function (s) { const activa = s.clave === seccion; %>
      <li>
        <a class="sm-admin-menu__item <%= activa ? 'sm-admin-menu__item--activa' : '' %>" href="<%= s.href %>" <%- activa ? 'aria-current="page"' : '' %>>
          <span><%= s.texto %></span>
          <% if (s.clave === 'resumen' && locals.alertasPendientes) { %>
            <span class="sm-admin-menu__contador" title="Alertas pendientes"><%= alertasPendientes %><span class="solo-lectores"> alertas pendientes</span></span>
          <% } %>
        </a>
      </li>
    <% }) %>
  </ul>
</nav>
