<%
  // Panel de marca de login / registro (solo escritorio, ver public/css/auth.css). Uso:
  //   include('partials/auth-marca', { titulo: 'La cancha te está <em>esperando</em>.' })
  // El título admite <em> para resaltar en verde: solo se pasa texto fijo desde las vistas.
%>
<aside class="auth-marca" aria-hidden="true">
  <span class="auth-marca__chip"><span class="badge__punto"></span>Fútbol amateur · Chile</span>
  <p class="auth-marca__titulo"><%- titulo %></p>
  <p class="auth-marca__texto">Encuentra pichangas cerca de ti, arma tu equipo y lleva tu carta de jugador a cada partido.</p>
  <ul class="auth-marca__lista">
    <li class="auth-marca__item">
      <svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
      <span><strong>Partidos cerca de ti</strong>Cupos por comuna y horario</span>
    </li>
    <li class="auth-marca__item">
      <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2.5" /><path d="M9 8h2M8.5 17h7M12 11.5a2 2 0 1 0 0 .01" /></svg>
      <span><strong>Tu carta de jugador</strong>Media, posición y estadísticas</span>
    </li>
    <li class="auth-marca__item">
      <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0" /><circle cx="17" cy="9" r="2.4" /><path d="M16 14.2a4.5 4.5 0 0 1 5 4.8" /></svg>
      <span><strong>Equipos y canchas</strong>Súmate a un plantel o reserva</span>
    </li>
  </ul>
</aside>
