<%
  // Fixture, tabla de posiciones (liga) y llave (relámpago) de un torneo ya empezado. Uso:
  //   include('partials/torneo-competencia', { torneo, admin: true })  → con formularios de resultado
  //   include('partials/torneo-competencia', { torneo, admin: false }) → solo lectura (jugadores)
  //   resaltar: ids de equipos a destacar (los del jugador)
  const resaltar = locals.resaltar || [];
  const esLlave = torneo.formato === 'relampago';
  function nombreEquipo(e) { return e ? e.nombre : 'Equipo eliminado'; }
  // Íconos de Lucide (Search, Shield, Check, ChevronDown) en línea: el sitio no usa React
  const ICONO = {
    buscar: '<circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />',
    escudo: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />',
    check: '<path d="M20 6 9 17l-5-5" />',
    chevron: '<path d="m6 9 6 6 6-6" />',
  };
  const svg = (nombre, clase) => `<svg class="${clase}" viewBox="0 0 24 24" aria-hidden="true">${ICONO[nombre]}</svg>`;
%>
<% if (torneo.formato === 'liga') { %>
  <div class="dash-panel eq-panel">
    <h2 class="dash-panel__titulo">Tabla de posiciones</h2>
    <div class="sm-tabla-contenedor">
      <table class="sm-tabla">
        <thead>
          <tr>
            <th scope="col">#</th><th scope="col" class="sm-tabla__equipo">Equipo</th>
            <th scope="col"><abbr title="Partidos jugados">PJ</abbr></th><th scope="col"><abbr title="Ganados">G</abbr></th>
            <th scope="col"><abbr title="Empatados">E</abbr></th><th scope="col"><abbr title="Perdidos">P</abbr></th>
            <th scope="col"><abbr title="Goles a favor">GF</abbr></th><th scope="col"><abbr title="Goles en contra">GC</abbr></th>
            <th scope="col"><abbr title="Diferencia de goles">DG</abbr></th><th scope="col"><abbr title="Puntos">Pts</abbr></th>
          </tr>
        </thead>
        <tbody>
          <% torneo.tabla.forEach(function (f, i) { %>
            <tr class="<%= resaltar.includes(f.id) ? 'sm-tabla__fila--mia' : '' %>">
              <td><%= i + 1 %></td><td class="sm-tabla__equipo"><%= f.nombre %></td>
              <td><%= f.pj %></td><td><%= f.pg %></td><td><%= f.pe %></td><td><%= f.pp %></td>
              <td><%= f.gf %></td><td><%= f.gc %></td><td><%= f.dg > 0 ? `+${f.dg}` : f.dg %></td><td><strong><%= f.pts %></strong></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="dash-panel__nota">Victoria 3 puntos, empate 1. Desempate: diferencia de goles y luego goles a favor.<%= torneo.descansos ? ' Con un número impar de equipos, en cada fecha uno descansa.' : '' %></p>
  </div>
<% } %>

<div class="dash-panel eq-panel <%= admin ? 'sm-cargar' : '' %>" <%- admin ? 'data-cargar-resultados' : '' %>>
  <h2 class="dash-panel__titulo"><%= esLlave ? 'Llave del torneo' : 'Fixture' %></h2>
  <% if (admin) { %>
    <!-- Buscador y filtros: los aplica torneo-admin.js sin recargar -->
    <div class="sm-cargar__barra">
      <label class="sm-cargar__buscar">
        <%- svg('buscar', 'sm-cargar__lupa') %>
        <span class="solo-lectores">Buscar equipo</span>
        <input type="search" placeholder="Buscar equipo…" autocomplete="off" data-buscar-partido />
      </label>
      <div class="sm-cargar__pills" role="group" aria-label="Filtrar partidos">
        <% [['todos', 'Todos'], ['pendiente', 'Pendientes'], ['jugado', 'Jugados']].forEach(function ([clave, texto], i) { %>
          <button type="button" class="sm-cargar__pill" data-filtro-partido="<%= clave %>" aria-pressed="<%= i === 0 %>"><%= texto %></button>
        <% }) %>
      </div>
    </div>
  <% } %>
  <% if (esLlave && !admin) { %>
    <%- include('torneo-llave', { torneo, resaltar }) %>
  <% } else { %>
  <div class="<%= esLlave ? 'sm-llave' : 'sm-fechas' %>" <%- esLlave ? 'data-llave' : '' %>>
    <% torneo.rondas.forEach(function (ronda) { %>
      <section class="sm-ronda" aria-label="<%= ronda.nombre %>">
        <h3 class="sm-ronda__titulo"><%= ronda.nombre %></h3>
        <ul class="sm-partidos">
          <% ronda.partidos.forEach(function (p) {
               const gano = (e) => p.jugado && esLlave && e && p.idGanador === e.id;
               const penales = p.jugado && esLlave && p.golesLocal === p.golesVisita;
               if (admin) {
                 const cargable = p.editable; %>
            <li class="sm-pcard <%= p.jugado ? 'sm-pcard--jugado' : '' %>" id="partido-<%= p.id %>" data-partido data-estado="<%= p.jugado ? 'jugado' : 'pendiente' %>" data-nombres="<%= `${nombreEquipo(p.local)} ${nombreEquipo(p.visita)}`.toLowerCase() %>">
              <div class="sm-pcard__equipos">
                <span class="sm-pcard__equipo <%= gano(p.local) ? 'sm-pcard__equipo--gano' : '' %>"><%- svg('escudo', 'sm-pcard__escudo') %><span><%= nombreEquipo(p.local) %></span></span>
                <span class="sm-pcard__vs">
                  <% if (p.jugado && !cargable) { %><strong class="sm-pcard__final"><%= p.golesLocal %> - <%= p.golesVisita %></strong><% } else { %>vs<% } %>
                  <% if (penales) { %><small>penales</small><% } %>
                </span>
                <span class="sm-pcard__equipo sm-pcard__equipo--visita <%= gano(p.visita) ? 'sm-pcard__equipo--gano' : '' %>"><span><%= nombreEquipo(p.visita) %></span><%- svg('escudo', 'sm-pcard__escudo') %></span>
              </div>
              <% if (cargable) { %>
                <form class="sm-pcard__form" method="POST" action="/admin/torneos/<%= torneo.id %>/partidos/<%= p.id %>">
                  <div class="sm-marcador">
                    <label class="solo-lectores" for="gl-<%= p.id %>">Goles de <%= nombreEquipo(p.local) %></label>
                    <input class="sm-marcador__caja" type="number" inputmode="numeric" id="gl-<%= p.id %>" name="goles_local" min="0" max="99" value="<%= p.golesLocal ?? '' %>" placeholder="0" required />
                    <span class="sm-marcador__guion" aria-hidden="true">-</span>
                    <label class="solo-lectores" for="gv-<%= p.id %>">Goles de <%= nombreEquipo(p.visita) %></label>
                    <input class="sm-marcador__caja" type="number" inputmode="numeric" id="gv-<%= p.id %>" name="goles_visita" min="0" max="99" value="<%= p.golesVisita ?? '' %>" placeholder="0" required />
                  </div>
                  <div class="sm-pcard__pie">
                    <% if (esLlave) { %>
                      <label class="sm-pcard__penales">
                        <span class="solo-lectores">Si empatan, quién ganó por penales</span>
                        <select name="ganador_penales" title="Si empatan, quién ganó por penales">
                          <option value="">Penales: —</option>
                          <option value="local" <%= penales && p.local && p.idGanador === p.local.id ? 'selected' : '' %>>Penales: <%= nombreEquipo(p.local) %></option>
                          <option value="visita" <%= penales && p.visita && p.idGanador === p.visita.id ? 'selected' : '' %>>Penales: <%= nombreEquipo(p.visita) %></option>
                        </select>
                        <%- svg('chevron', 'sm-pcard__chevron') %>
                      </label>
                    <% } %>
                    <button type="submit" class="sm-pcard__guardar"><%- svg('check', 'sm-pcard__check') %><%= p.jugado ? 'Corregir resultado' : 'Guardar resultado' %></button>
                  </div>
                </form>
              <% } %>
            </li>
          <% return; } %>
            <li class="sm-partido <%= (p.local && resaltar.includes(p.local.id)) || (p.visita && resaltar.includes(p.visita.id)) ? 'sm-partido--mio' : '' %>" id="partido-<%= p.id %>">
              <span class="sm-partido__equipo <%= gano(p.local) ? 'sm-partido__equipo--gano' : '' %>" <%- p.local ? `data-equipo="${p.local.id}"` : '' %>><%= nombreEquipo(p.local) %></span>
              <span class="sm-partido__marcador">
                <%= p.jugado ? `${p.golesLocal} - ${p.golesVisita}` : 'vs' %>
                <% if (penales) { %><small>(penales)</small><% } %>
              </span>
              <span class="sm-partido__equipo sm-partido__equipo--visita <%= gano(p.visita) ? 'sm-partido__equipo--gano' : '' %>" <%- p.visita ? `data-equipo="${p.visita.id}"` : '' %>><%= nombreEquipo(p.visita) %></span>
              <% if (admin && p.editable) { %>
                <form class="sm-resultado" method="POST" action="/admin/torneos/<%= torneo.id %>/partidos/<%= p.id %>">
                  <label class="solo-lectores" for="gl-<%= p.id %>">Goles de <%= nombreEquipo(p.local) %></label>
                  <input type="number" id="gl-<%= p.id %>" name="goles_local" min="0" max="99" value="<%= p.golesLocal ?? '' %>" required />
                  <span aria-hidden="true">-</span>
                  <label class="solo-lectores" for="gv-<%= p.id %>">Goles de <%= nombreEquipo(p.visita) %></label>
                  <input type="number" id="gv-<%= p.id %>" name="goles_visita" min="0" max="99" value="<%= p.golesVisita ?? '' %>" required />
                  <% if (esLlave) { %>
                    <select name="ganador_penales" aria-label="Si empatan, quién ganó por penales" title="Si empatan, quién ganó por penales">
                      <option value="">Penales: —</option>
                      <option value="local" <%= penales && p.local && p.idGanador === p.local.id ? 'selected' : '' %>>Penales: <%= nombreEquipo(p.local) %></option>
                      <option value="visita" <%= penales && p.visita && p.idGanador === p.visita.id ? 'selected' : '' %>>Penales: <%= nombreEquipo(p.visita) %></option>
                    </select>
                  <% } %>
                  <button type="submit" class="btn btn--verde btn--chico"><%= p.jugado ? 'Corregir' : 'Guardar' %></button>
                </form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </section>
    <% }) %>
  </div>
  <% } %>
  <% if (admin) { %><p class="dash-panel__nota sm-cargar__vacio" data-sin-partidos hidden>Ningún partido coincide con la búsqueda.</p><% } %>
</div>
