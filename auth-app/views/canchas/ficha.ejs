<%- include('../partials/header') %>

<%- include('../partials/cursor-luz') %>

<%
  const pesos = new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 });
%>
<section class="eq">
  <div class="contenedor">
    <header class="eq-cabecera revelar">
      <div class="eq-cabecera__texto">
        <%- include('../partials/boton-volver', { fallbackUrl: '/canchas' }) %>
        <h1 class="eq-cabecera__titulo"><%= cancha.nombre %></h1>
        <p class="eq-cabecera__stats"><%= cancha.recinto %> · <%= cancha.comuna %>, <%= cancha.region %></p>
      </div>
      <div class="eq-cabecera__acciones">
        <span class="sm-precio sm-precio--grande"><%= pesos.format(cancha.precio) %><small>/hora</small></span>
        <a class="btn btn--verde btn--grande" href="/canchas/<%= cancha.id %>/reservar">Reservar</a>
      </div>
    </header>

    <div class="sm-columnas">
      <div class="dash-panel eq-panel revelar">
        <header class="dash-panel__cabecera">
          <h2 class="dash-panel__titulo">Datos de la cancha</h2>
        </header>
        <dl class="sm-datos">
          <div><dt>Modalidad</dt><dd><%= cancha.modalidad %> · <%= cancha.jugadores %> jugadores por equipo</dd></div>
          <div><dt>Recinto</dt><dd><%= cancha.recinto %></dd></div>
          <div><dt>Dirección</dt><dd><%= cancha.direccion %>, <%= cancha.comuna %><% if (cancha.referencias) { %><br><small><%= cancha.referencias %></small><% } %></dd></div>
          <div><dt>Teléfono del recinto</dt><dd>
            <% if (cancha.telefono) { %><a href="tel:<%= cancha.telefono %>"><%= cancha.telefono %></a><% } else { %>—<% } %>
          </dd></div>
          <% if (cancha.latitud !== null && cancha.longitud !== null) { %>
            <div><dt>Cómo llegar</dt><dd>
              <a href="https://www.openstreetmap.org/?mlat=<%= cancha.latitud %>&mlon=<%= cancha.longitud %>#map=17/<%= cancha.latitud %>/<%= cancha.longitud %>" target="_blank" rel="noopener">Ver en el mapa</a>
            </dd></div>
          <% } %>
        </dl>
      </div>

      <div class="dash-panel eq-panel revelar">
        <header class="dash-panel__cabecera">
          <h2 class="dash-panel__titulo">Horario de la semana</h2>
        </header>
        <% if (referencial) { %>
          <p class="sm-nota-horario">Horario referencial: el recinto aún no publica el suyo. Confírmalo por teléfono si es un horario límite.</p>
        <% } %>
        <ul class="sm-horario">
          <% horario.forEach(function (dia) { %>
            <li class="sm-horario__dia <%= dia.bloques.length === 0 ? 'sm-horario__dia--cerrado' : '' %>">
              <span class="sm-horario__nombre"><%= dia.nombre %></span>
              <% if (dia.bloques.length === 0) { %>
                <span class="sm-horario__cerrado">Cerrado</span>
              <% } else { %>
                <span class="sm-horario__bloques">
                  <% dia.bloques.forEach(function (b) { %><span class="sm-bloque"><%= b.apertura %>–<%= b.cierre %></span><% }) %>
                </span>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>

    <% if (cancha.latitud !== null && cancha.longitud !== null) { %>
      <div class="dash-panel eq-panel revelar">
        <header class="dash-panel__cabecera">
          <h2 class="dash-panel__titulo">Ubicación</h2>
          <a class="dash-panel__enlace" href="https://www.openstreetmap.org/?mlat=<%= cancha.latitud %>&mlon=<%= cancha.longitud %>#map=17/<%= cancha.latitud %>/<%= cancha.longitud %>" target="_blank" rel="noopener">Abrir mapa grande →</a>
        </header>
        <div class="sm-mapa sm-mapa--ficha" id="mapa-canchas" role="region" aria-label="Ubicación de <%= cancha.recinto %>"></div>
      </div>
      <script type="application/json" id="datos-mapa"><%- JSON.stringify([{
        nombre: cancha.recinto, comuna: cancha.comuna, direccion: cancha.direccion,
        latitud: cancha.latitud, longitud: cancha.longitud,
        canchas: [{ id: cancha.id, nombre: cancha.nombre, modalidad: cancha.modalidad, precio: cancha.precio }],
      }]).replace(/</g, '\\u003c') %></script>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
            integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
              integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer></script>
      <script src="/js/canchas-mapa.js?v=<%= versionAssets %>" defer></script>
    <% } %>

    <div class="dash-panel eq-panel revelar">
      <header class="dash-panel__cabecera">
        <h2 class="dash-panel__titulo">Próximos 7 días</h2>
      </header>
      <p class="sm-leyenda">
        <span class="sm-franja sm-franja--libre sm-franja--muestra">Libre</span>
        <span class="sm-franja sm-franja--ocupado sm-franja--muestra">Ocupado</span>
        <span class="sm-leyenda__texto">Toca un horario libre para reservarlo.</span>
      </p>
      <ul class="sm-agenda">
        <% dias.forEach(function (d) { %>
          <li class="sm-agenda__dia <%= d.franjas.length === 0 ? 'sm-agenda__dia--cerrado' : '' %>">
            <span class="sm-agenda__fecha"><%= d.etiqueta %>
              <% if (d.franjas.length) { %><small class="sm-agenda__libres"><%= d.libres %> libre<%= d.libres === 1 ? '' : 's' %></small><% } %>
            </span>
            <% if (d.franjas.length === 0) { %>
              <span class="sm-horario__cerrado">Cerrado</span>
            <% } else { %>
              <span class="sm-franjas">
                <% d.franjas.forEach(function (f) { %>
                  <% if (f.estado === 'libre') { %>
                    <a class="sm-franja sm-franja--libre" href="/canchas/<%= cancha.id %>/reservar?fecha=<%= d.fecha %>&inicio=<%= f.inicio %>&fin=<%= f.fin %>"
                       aria-label="Reservar <%= d.etiqueta %> de <%= f.inicio %> a <%= f.fin %>"><%= f.inicio %></a>
                  <% } else { %>
                    <span class="sm-franja sm-franja--<%= f.estado %>" title="<%= f.estado === 'ocupado' ? 'Ocupado' : 'Ya pasó' %>"><%= f.inicio %></span>
                  <% } %>
                <% }) %>
              </span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</section>

<%- include('../partials/dock', { activo: 'canchas' }) %>

<%- include('../partials/footer') %>
