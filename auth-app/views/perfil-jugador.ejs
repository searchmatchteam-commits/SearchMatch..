<%- include('partials/header') %>
<%
  // Pasos del wizard. El 1 (tipo de cuenta) ya se completó en /select-role.
  // "Crear equipo" solo existe si en el paso 4 elige "Soy capitán" (wizard.js lo muestra u oculta).
  const pasos = [
    { numero: 1, nombre: 'Tipo de cuenta' },
    { numero: 2, nombre: 'Datos personales' },
    { numero: 3, nombre: 'Perfil deportivo' },
    { numero: 4, nombre: 'Tu rol' },
    { numero: 5, nombre: 'Crear equipo', soloCapitan: true },
    { numero: 6, nombre: 'Confirmación' },
  ];
  const esCapitan = datos.rol === 'capitan';
  const visibles = pasos.filter(function (p) { return esCapitan || !p.soloCapitan; });
  const posicionActual = Math.max(0, visibles.findIndex(function (p) { return p.numero === paso; }));
  const equipo = datos.equipo || {};
  // Altura de la marca en la mini cancha de cada posición (0 = arco rival, 32 = arco propio).
  const alturaPosicion = { arquero: 27, defensa: 21, mediocampista: 15, delantero: 7 };
  const hoy = new Date().toISOString().slice(0, 10);
  const iconoEscudo = '<path d="M12 3l8 3v6c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6z" />';
%>

<section class="wizard">
  <!-- Lado izquierdo: branding sobre una cancha muy tenue -->
  <aside class="wizard__marca">
    <span class="rol__eyebrow">SEARCH MATCH · PERFIL</span>
    <h2 class="wizard__marca-titulo">Encuentra tu próximo <span class="texto-verde">partido</span></h2>
    <p class="wizard__marca-texto">Completa tu perfil y obtén tu carta de jugador. Así te encontrarán equipos y jugadores de tu nivel.</p>

    <ul class="wizard__beneficios">
      <li>
        <span class="wizard__beneficio-icono" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0" /><circle cx="17" cy="9" r="2.4" /><path d="M16 14.2a4.5 4.5 0 0 1 5 4.8" /></svg>
        </span>
        Encuentra jugadores de tu nivel
      </li>
      <li>
        <span class="wizard__beneficio-icono" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4M9 14.5l2 2 4-4" /></svg>
        </span>
        Organiza partidos en minutos
      </li>
      <li>
        <span class="wizard__beneficio-icono" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 19V11M10 19V6M16 19v-5M21 19H3" /></svg>
        </span>
        Sube tus estadísticas partido a partido
      </li>
      <li>
        <span class="wizard__beneficio-icono" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3l7.5 3v5.5c0 4.6-3 8.2-7.5 9.5-4.5-1.3-7.5-4.9-7.5-9.5V6z" /><path d="M9 12l2 2 4-4" /></svg>
        </span>
        Únete a equipos y desafíos cerca de ti
      </li>
    </ul>
  </aside>

  <!-- Lado derecho: el formulario -->
  <div class="wizard__panel">
    <!-- Barra de progreso: wizard.js actualiza las clases, la numeración, --progreso y --cantidad-pasos
         al cambiar de paso o de rol (el capitán suma "Crear equipo") -->
    <div class="pasos" data-pasos style="--progreso: <%= posicionActual / (visibles.length - 1) %>; --cantidad-pasos: <%= visibles.length %>">
      <div class="pasos__barra" aria-hidden="true"><span></span></div>
      <ol class="pasos__lista">
        <% pasos.forEach(function (p) {
             const posicion = visibles.indexOf(p); %>
          <li class="pasos__item <%= posicion === -1 ? '' : posicion < posicionActual ? 'pasos__item--hecho' : posicion === posicionActual ? 'pasos__item--activo' : '' %>"
              data-indicador="<%= p.numero %>" <%- p.soloCapitan ? 'data-solo-capitan' : '' %> <%- posicion === -1 ? 'hidden' : '' %>
              <%- p.numero === paso ? 'aria-current="step"' : '' %>>
            <span class="pasos__marca">
              <svg class="pasos__check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" /></svg>
              <span class="pasos__numero"><%= posicion === -1 ? p.numero : posicion + 1 %></span>
            </span>
            <span class="pasos__nombre"><%= p.nombre %></span>
          </li>
        <% }) %>
      </ol>
    </div>

    <form action="/perfil-jugador" method="POST" class="formulario wizard__form" data-wizard data-paso-inicial="<%= paso %>" novalidate>
      <!-- ============ PASO 2: DATOS PERSONALES ============ -->
      <fieldset class="wizard__paso" data-paso="2">
        <legend class="wizard__titulo">Datos personales</legend>
        <p class="wizard__subtitulo">Así aparecerás en tu carta y en las búsquedas.</p>

        <!-- Nombre y apellido ya se pidieron al crear la cuenta (/registro) -->
        <div class="campo">
          <label for="apodo">Apodo</label>
          <input type="text" id="apodo" name="apodo" placeholder="Ej. El Niño Maravilla" value="<%= datos.apodo || '' %>"
                 autocomplete="nickname" maxlength="20" aria-describedby="apodo-ayuda apodo-error" required />
          <small class="campo__ayuda" id="apodo-ayuda">Es el nombre que aparecerá en tu carta.</small>
          <small class="campo__error" id="apodo-error"></small>
        </div>

        <div class="campo">
          <label for="fecha_nacimiento">Fecha de nacimiento</label>
          <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" value="<%= datos.fechaNacimiento || '' %>"
                 max="<%= hoy %>" autocomplete="bday" aria-describedby="fecha_nacimiento-error" required />
          <small class="campo__error" id="fecha_nacimiento-error"></small>
        </div>

        <div class="formulario__fila">
          <div class="campo">
            <label for="altura">Altura</label>
            <div class="campo__unidad" data-unidad="cm">
              <input type="number" id="altura" name="altura" placeholder="Ej. 175" value="<%= datos.altura || '' %>"
                     inputmode="numeric" min="<%= rangos.ALTURA_CM.min %>" max="<%= rangos.ALTURA_CM.max %>"
                     aria-describedby="altura-error" required />
            </div>
            <small class="campo__error" id="altura-error"></small>
          </div>
          <div class="campo">
            <label for="peso">Peso</label>
            <div class="campo__unidad" data-unidad="kg">
              <input type="number" id="peso" name="peso" placeholder="Ej. 70" value="<%= datos.peso || '' %>"
                     inputmode="numeric" min="<%= rangos.PESO_KG.min %>" max="<%= rangos.PESO_KG.max %>"
                     aria-describedby="peso-error" required />
            </div>
            <small class="campo__error" id="peso-error"></small>
          </div>
        </div>
      </fieldset>

      <!-- ============ PASO 3: PERFIL DEPORTIVO ============ -->
      <fieldset class="wizard__paso" data-paso="3">
        <legend class="wizard__titulo">Perfil deportivo</legend>
        <p class="wizard__subtitulo">Con esto armamos tu carta y te sugerimos partidos.</p>

        <div class="grupo-opciones" role="group" aria-labelledby="posicion-label" aria-describedby="posicion-ayuda posicion-error" data-grupo="posicion">
          <span class="grupo-opciones__label" id="posicion-label">Posiciones en la cancha</span>
          <small class="campo__ayuda" id="posicion-ayuda">Puedes marcar más de una (toca otra vez para quitarla).</small>
          <div class="opciones opciones--4">
            <% Object.entries(catalogos.POSICIONES).forEach(function ([clave, pos]) { %>
              <label class="opcion opcion--posicion">
                <input class="opcion__radio" type="checkbox" name="posicion" value="<%= clave %>" <%= (datos.posiciones || []).includes(clave) ? 'checked' : '' %> />
                <svg class="opcion__cancha" viewBox="0 0 24 34" aria-hidden="true">
                  <rect x="1" y="1" width="22" height="32" rx="2" />
                  <path d="M1 17h22M8 1v4h8V1M8 33v-4h8v4" />
                  <circle cx="12" cy="17" r="3.2" />
                  <circle class="opcion__punto" cx="12" cy="<%= alturaPosicion[clave] %>" r="3" />
                </svg>
                <span class="opcion__sigla"><%= pos.sigla %></span>
                <span class="opcion__nombre"><%= pos.etiqueta %></span>
              </label>
            <% }) %>
          </div>
          <small class="campo__error" id="posicion-error"></small>
        </div>
      </fieldset>

      <!-- ============ PASO 4: ROL (jugador o capitán) ============ -->
      <!-- Tarjetas = radios: funcionan con teclado y sin JS. Con JS, elegir una avanza al paso siguiente. -->
      <fieldset class="wizard__paso" data-paso="4">
        <legend class="wizard__titulo">¿Cómo vas a jugar?</legend>
        <p class="wizard__subtitulo">Elige tu rol. Como capitán crearás tu equipo en el siguiente paso.</p>

        <div class="grupo-opciones" role="radiogroup" aria-labelledby="rol-label" aria-describedby="rol-error" data-grupo="rol">
          <span class="solo-lectores" id="rol-label">Tu rol en Search Match</span>
          <div class="rol__opciones">
            <label class="rol-tarjeta">
              <input class="rol-tarjeta__radio" type="radio" name="rol" value="jugador" <%= datos.rol === 'jugador' ? 'checked' : '' %> />
              <span class="rol-tarjeta__check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7" /></svg></span>
              <span class="rol-tarjeta__icono" aria-hidden="true">
                <!-- Camiseta -->
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round">
                  <path d="M17 6h14l11 7-5 9-5-3v23H16V19l-5 3-5-9z" />
                  <path d="M19 6c0 3 2.2 5 5 5s5-2 5-5" />
                  <path d="M21 25h6M24 22v10" stroke-linecap="round" />
                </svg>
              </span>
              <span class="rol-tarjeta__titulo">Soy jugador</span>
              <span class="rol-tarjeta__texto">Obtén tu carta y súmate a partidos y equipos cerca de ti.</span>
              <ul class="rol-tarjeta__lista">
                <li>Carta con tu nivel y posición</li>
                <li>Únete a equipos de tu comuna</li>
                <li>Recibe invitaciones y desafíos</li>
              </ul>
            </label>

            <label class="rol-tarjeta <%= puedeSerCapitan ? '' : 'rol-tarjeta--apagada' %>">
              <input class="rol-tarjeta__radio" type="radio" name="rol" value="capitan" <%= datos.rol === 'capitan' && puedeSerCapitan ? 'checked' : '' %> <%= puedeSerCapitan ? '' : 'disabled' %> />
              <span class="rol-tarjeta__check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7" /></svg></span>
              <span class="rol-tarjeta__icono rol-tarjeta__icono--escudo" aria-hidden="true">
                <!-- Escudo con la palabra CAPITÁN -->
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round">
                  <path d="M24 4l16 6v12c0 10.5-6.8 18.6-16 22-9.2-3.4-16-11.5-16-22V10z" />
                  <path d="M24 13l2.4 4.8 5.3.8-3.8 3.7.9 5.2-4.8-2.5-4.8 2.5.9-5.2-3.8-3.7 5.3-.8z" fill="currentColor" stroke="none" />
                </svg>
                <span class="rol-tarjeta__capitan">CAPITÁN</span>
              </span>
              <span class="rol-tarjeta__titulo">Soy capitán</span>
              <span class="rol-tarjeta__texto">
                <%= puedeSerCapitan ? 'Crea tu equipo, organiza partidos y desafía a otros equipos.' : 'Ya eres capitán de un equipo: continúa como jugador.' %>
              </span>
              <ul class="rol-tarjeta__lista">
                <li>Gestiona tu plantel</li>
                <li>Reserva canchas y agenda partidos</li>
                <li>Desafía equipos de tu nivel</li>
              </ul>
            </label>
          </div>
          <small class="campo__error" id="rol-error"></small>
        </div>
      </fieldset>

      <!-- ============ PASO 5: CREAR EQUIPO (solo capitán) ============ -->
      <fieldset class="wizard__paso" data-paso="5" data-solo-capitan>
        <legend class="wizard__titulo">Crear equipo</legend>
        <p class="wizard__subtitulo">Tu escuadra quedará lista para recibir jugadores y desafíos. <span class="wizard__solo-sin-js">Solo si elegiste "Soy capitán".</span></p>

        <!-- Escudo opcional: wizard.js lo reduce y lo guarda como imagen en el campo oculto "escudo" -->
        <div class="wizard-escudo">
          <span class="wizard-escudo__vista" data-escudo-vista>
            <% if (datos.escudo) { %>
              <img src="<%= datos.escudo %>" alt="" />
            <% } else { %>
              <svg viewBox="0 0 24 24" aria-hidden="true"><%- iconoEscudo %></svg>
            <% } %>
          </span>
          <span class="wizard-escudo__texto">
            <span class="wizard-escudo__titulo">Escudo del equipo</span>
            <small class="campo__ayuda" id="escudo-ayuda">Opcional · JPG, PNG o WebP. También puedes subirlo después en tu panel.</small>
            <label class="btn btn--oscuro btn--chico wizard-escudo__boton" data-escudo-boton hidden>
              Subir escudo
              <input type="file" accept="image/png,image/jpeg,image/webp" class="solo-lectores" aria-describedby="escudo-ayuda escudo-error" data-escudo-archivo />
            </label>
            <small class="campo__error" id="escudo-error" data-escudo-error></small>
          </span>
          <input type="hidden" name="escudo" value="<%= datos.escudo || '' %>" data-escudo-datos />
        </div>

        <div class="campo">
          <label for="nombre_equipo">Nombre del equipo</label>
          <input type="text" id="nombre_equipo" name="nombre_equipo" placeholder="Ej. Los Titanes F.C." value="<%= equipo.nombre || '' %>"
                 autocomplete="off" maxlength="100" aria-describedby="nombre_equipo-error" required />
          <small class="campo__error" id="nombre_equipo-error"></small>
        </div>

        <%- include('partials/sm-ubicacion', { regiones, idRegion: equipo.idRegion, idComuna: equipo.idComuna, obligatorio: true }) %>

        <div class="grupo-opciones" role="radiogroup" aria-labelledby="nivel-label" aria-describedby="nivel-error" data-grupo="nivel">
          <span class="grupo-opciones__label" id="nivel-label">Nivel de juego</span>
          <div class="opciones opciones--3">
            <% Object.entries(catalogos.NIVELES).forEach(function ([clave, nombre]) { %>
              <label class="opcion opcion--nivel">
                <input class="opcion__radio" type="radio" name="nivel" value="<%= clave %>" <%= equipo.nivel === clave ? 'checked' : '' %> />
                <span class="opcion__barras" aria-hidden="true">
                  <% for (let b = 1; b <= 3; b++) { %><span class="<%= b <= catalogos.BARRAS_NIVEL[clave] ? 'llena' : '' %>"></span><% } %>
                </span>
                <span class="opcion__nombre"><%= nombre %></span>
                <span class="opcion__detalle"><%= catalogos.DETALLE_NIVEL[clave] %></span>
              </label>
            <% }) %>
          </div>
          <small class="campo__error" id="nivel-error"></small>
        </div>

        <div class="grupo-opciones" role="group" aria-labelledby="modalidad-label" aria-describedby="modalidad-ayuda modalidad-error" data-grupo="modalidad">
          <span class="grupo-opciones__label" id="modalidad-label">Tipos de fútbol</span>
          <small class="campo__ayuda" id="modalidad-ayuda">Puedes marcar varios.</small>
          <div class="opciones opciones--3">
            <% Object.entries(catalogos.MODALIDADES).forEach(function ([jugadores, nombre]) { %>
              <label class="opcion">
                <input class="opcion__radio" type="checkbox" name="modalidad" value="<%= jugadores %>" <%= (equipo.modalidades || []).includes(Number(jugadores)) ? 'checked' : '' %> />
                <span class="opcion__sigla">F<%= jugadores %></span>
                <span class="opcion__nombre"><%= nombre %></span>
              </label>
            <% }) %>
          </div>
          <small class="campo__error" id="modalidad-error"></small>
        </div>
      </fieldset>

      <!-- ============ PASO 6: CONFIRMACIÓN ============ -->
      <fieldset class="wizard__paso" data-paso="6">
        <legend class="wizard__titulo">Confirmación</legend>
        <p class="wizard__subtitulo">Revisa tus datos. Al confirmar generaremos tu carta con tus estadísticas iniciales.</p>

        <!-- wizard.js copia aquí los valores de los pasos anteriores -->
        <dl class="resumen">
          <div><dt>Apodo en la carta</dt><dd data-resumen="apodo">—</dd></div>
          <div><dt>Nacimiento</dt><dd data-resumen="fecha_nacimiento">—</dd></div>
          <div><dt>Altura</dt><dd data-resumen="altura">—</dd></div>
          <div><dt>Peso</dt><dd data-resumen="peso">—</dd></div>
          <div><dt>Posiciones</dt><dd data-resumen="posicion">—</dd></div>
          <div><dt>Rol</dt><dd data-resumen="rol">—</dd></div>
        </dl>

        <!-- Solo capitán: el equipo que se creará al guardar -->
        <div class="resumen-equipo" data-solo-capitan <%- esCapitan ? '' : 'hidden' %>>
          <p class="resumen-equipo__titulo">Datos del equipo</p>
          <dl class="resumen">
            <div><dt>Nombre del equipo</dt><dd data-resumen="nombre_equipo">—</dd></div>
            <div><dt>Comuna</dt><dd data-resumen="id_comuna">—</dd></div>
            <div><dt>Nivel</dt><dd data-resumen="nivel">—</dd></div>
            <div><dt>Tipos de fútbol</dt><dd data-resumen="modalidad">—</dd></div>
          </dl>
        </div>
      </fieldset>

      <!-- Errores del servidor o de wizard.js -->
      <div class="alerta alerta--error" role="alert" data-alerta-errores <%= errores.length > 0 ? '' : 'hidden' %>>
        <ul>
          <% errores.forEach(function (error) { %><li><%= error %></li><% }) %>
        </ul>
      </div>

      <div class="wizard__nav">
        <!-- Sin JS vuelve a la selección de rol; wizard.js lo convierte en "paso anterior" -->
        <a class="btn btn--oscuro btn--grande" href="/select-role" data-volver>
          <span aria-hidden="true">←</span> Volver
        </a>
        <button type="submit" class="btn btn--verde btn--grande" data-continuar
                data-texto-final="GUARDAR Y ENTRAR AL PANEL" data-texto-final-capitan="CREAR EQUIPO Y ENTRAR AL PANEL"
                data-texto-cargando="GUARDANDO...">
          <span class="btn__spinner" aria-hidden="true"></span>
          <span class="btn__texto">GUARDAR Y ENTRAR AL PANEL</span>
          <span class="btn__flecha" aria-hidden="true">→</span>
        </button>
      </div>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
