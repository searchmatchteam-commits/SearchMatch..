<%- include('partials/header') %>
<%
  const pasos = ['Tipo de cuenta', 'Datos personales', 'Perfil deportivo', 'Confirmación'];
  const alturaPosicion = { arquero: 27, defensa: 21, mediocampista: 15, delantero: 7 };
  const hoy = new Date().toISOString().slice(0, 10);
%>

<section class="wizard">
  <aside class="wizard__marca">
    <span class="rol__eyebrow">SEARCH MATCH · PERFIL</span>
    <h2 class="wizard__marca-titulo">Encuentra tu próximo <span class="texto-verde">partido</span></h2>
    <p class="wizard__marca-texto">Completa tu perfil y obtén tu carta de jugador. Así te encontrarán equipos y jugadores de tu nivel.</p>

    <ul class="wizard__beneficios">
      <li>
        <span class="wizard__beneficio-icono" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2" /><path d="M3.5 19a5.5 5.5 0 0 1 11 0" /><circle cx="17" cy="9" r="2.4" /><path d="M16 14.2a4.5 4.5 0 0 1 5 4.8" /></svg>
        </span>
        Encuentra jugadores de tu nivel
      </li>
      <li>
        <span class="wizard__beneficio-icono" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4M9 14.5l2 2 4-4" /></svg>
        </span>
        Organiza partidos en minutos
      </li>
      <li>
        <span class="wizard__beneficio-icono" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 19V11M10 19V6M16 19v-5M21 19H3" /></svg>
        </span>
        Sube tus estadísticas partido a partido
      </li>
      <li>
        <span class="wizard__beneficio-icono" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3l7.5 3v5.5c0 4.6-3 8.2-7.5 9.5-4.5-1.3-7.5-4.9-7.5-9.5V6z" /><path d="M9 12l2 2 4-4" /></svg>
        </span>
        Únete a equipos y desafíos cerca de ti
      </li>
    </ul>
  </aside>

  <div class="wizard__panel">
    <div class="pasos" data-pasos style="--progreso: <%= (paso - 1) / (pasos.length - 1) %>">
      <div class="pasos__barra" aria-hidden="true"><span></span></div>
      <ol class="pasos__lista">
        <% pasos.forEach(function (nombre, i) { const numero = i + 1; %>
          <li class="pasos__item <%= numero < paso ? 'pasos__item--hecho' : numero === paso ? 'pasos__item--activo' : '' %>"
              data-indicador="<%= numero %>" <%- numero === paso ? 'aria-current="step"' : '' %>>
            <span class="pasos__marca">
              <svg class="pasos__check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7" /></svg>
              <span class="pasos__numero"><%= numero %></span>
            </span>
            <span class="pasos__nombre"><%= nombre %></span>
          </li>
        <% }) %>
      </ol>
    </div>

    <form action="/perfil-jugador" method="POST" class="formulario wizard__form" data-wizard data-paso-inicial="<%= paso %>" novalidate>
      <fieldset class="wizard__paso" data-paso="2">
        <legend class="wizard__titulo">Datos personales</legend>
        <p class="wizard__subtitulo">Así aparecerás en tu carta y en las búsquedas.</p>

        <div class="campo">
          <label for="apodo">Apodo</label>
          <input type="text" id="apodo" name="apodo" placeholder="Ej. El Niño Maravilla" value="<%= datos.apodo || '' %>"
                 autocomplete="nickname" maxlength="20" aria-describedby="apodo-ayuda apodo-error" required />
          <small class="campo__ayuda" id="apodo-ayuda">Es el nombre que aparecerá en tu carta.</small>
          <small class="campo__error" id="apodo-error"></small>
        </div>

        <div class="campo">
          <label for="fecha_nacimiento">Fecha de nacimiento</label>
          <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" value="<%= datos.fechaNacimiento || '' %>"
                 max="<%= hoy %>" autocomplete="bday" aria-describedby="fecha_nacimiento-error" required />
          <small class="campo__error" id="fecha_nacimiento-error"></small>
        </div>

        <div class="formulario__fila">
          <div class="campo">
            <label for="altura">Altura</label>
            <div class="campo__unidad" data-unidad="cm">
              <input type="number" id="altura" name="altura" placeholder="Ej. 175" value="<%= datos.altura || '' %>"
                     inputmode="numeric" min="<%= rangos.ALTURA_CM.min %>" max="<%= rangos.ALTURA_CM.max %>"
                     aria-describedby="altura-error" required />
            </div>
            <small class="campo__error" id="altura-error"></small>
          </div>
          <div class="campo">
            <label for="peso">Peso</label>
            <div class="campo__unidad" data-unidad="kg">
              <input type="number" id="peso" name="peso" placeholder="Ej. 70" value="<%= datos.peso || '' %>"
                     inputmode="numeric" min="<%= rangos.PESO_KG.min %>" max="<%= rangos.PESO_KG.max %>"
                     aria-describedby="peso-error" required />
            </div>
            <small class="campo__error" id="peso-error"></small>
          </div>
        </div>
      </fieldset>

      <fieldset class="wizard__paso" data-paso="3">
        <legend class="wizard__titulo">Perfil deportivo</legend>
        <p class="wizard__subtitulo">Con esto armamos tu carta y te sugerimos partidos.</p>

        <div class="grupo-opciones" role="group" aria-labelledby="posicion-label" aria-describedby="posicion-ayuda posicion-error" data-grupo="posicion">
          <span class="grupo-opciones__label" id="posicion-label">Posiciones en la cancha</span>
          <small class="campo__ayuda" id="posicion-ayuda">Puedes marcar más de una (toca otra vez para quitarla).</small>
          <div class="opciones opciones--4">
            <% Object.entries(catalogos.POSICIONES).forEach(function ([clave, pos]) { %>
              <label class="opcion opcion--posicion">
                <input class="opcion__radio" type="checkbox" name="posicion" value="<%= clave %>" <%= (datos.posiciones || []).includes(clave) ? 'checked' : '' %> />
                <svg class="opcion__cancha" viewBox="0 0 24 34" aria-hidden="true">
                  <rect x="1" y="1" width="22" height="32" rx="2" />
                  <path d="M1 17h22M8 1v4h8V1M8 33v-4h8v4" />
                  <circle cx="12" cy="17" r="3.2" />
                  <circle class="opcion__punto" cx="12" cy="<%= alturaPosicion[clave] %>" r="3" />
                </svg>
                <span class="opcion__sigla"><%= pos.sigla %></span>
                <span class="opcion__nombre"><%= pos.etiqueta %></span>
              </label>
            <% }) %>
          </div>
          <small class="campo__error" id="posicion-error"></small>
        </div>
      </fieldset>

      <fieldset class="wizard__paso" data-paso="4">
        <legend class="wizard__titulo">Confirmación</legend>
        <p class="wizard__subtitulo">Revisa tus datos. Al confirmar generaremos tu carta con tus estadísticas iniciales.</p>

        <dl class="resumen">
          <div><dt>Apodo en la carta</dt><dd data-resumen="apodo">—</dd></div>
          <div><dt>Nacimiento</dt><dd data-resumen="fecha_nacimiento">—</dd></div>
          <div><dt>Altura</dt><dd data-resumen="altura">—</dd></div>
          <div><dt>Peso</dt><dd data-resumen="peso">—</dd></div>
          <div><dt>Posiciones</dt><dd data-resumen="posicion">—</dd></div>
        </dl>
      </fieldset>

      <div class="alerta alerta--error" role="alert" data-alerta-errores <%= errores.length > 0 ? '' : 'hidden' %>>
        <ul>
          <% errores.forEach(function (error) { %><li><%= error %></li><% }) %>
        </ul>
      </div>

      <div class="wizard__nav">
        <a class="btn btn--oscuro btn--grande" href="/select-role" data-volver>
          <span aria-hidden="true">←</span> Volver
        </a>
        <button type="submit" class="btn btn--verde btn--grande" data-continuar
                data-texto-final="GUARDAR Y ENTRAR AL PANEL" data-texto-cargando="GUARDANDO...">
          <span class="btn__spinner" aria-hidden="true"></span>
          <span class="btn__texto">GUARDAR Y ENTRAR AL PANEL</span>
          <span class="btn__flecha" aria-hidden="true">→</span>
        </button>
      </div>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
