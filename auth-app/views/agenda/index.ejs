<%- include('../partials/header') %>

<%- include('../partials/fondo-cyber', { variante: 'perspectiva' }) %>

<%
  const formatoDia = new Intl.DateTimeFormat('es-CL', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
  const diaLargo = new Intl.DateTimeFormat('es-CL', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
  function fila(p) {
    return { dia: formatoDia.format(new Date(p.fecha + 'T00:00:00Z')), estado: p.cancelado ? 'Cancelado' : p.marcador_desafiante !== null ? `${p.marcador_desafiante} – ${p.marcador_desafiado}` : 'Programado' };
  }
%>
<section class="eq">
  <div class="contenedor">
    <header class="eq-cabecera revelar">
      <div class="eq-cabecera__texto">
        <%- include('../partials/boton-volver') %>
        <h1 class="eq-cabecera__titulo">Agenda de partidos</h1>
        <p class="eq-cabecera__stats">Los partidos de todos tus equipos.</p>
      </div>
      <div class="eq-cabecera__acciones">
        <a class="btn btn--contorno btn--grande" href="/reservas">Mis reservas</a>
      </div>
    </header>

    <div class="sm-columnas">
      <section class="dash-panel eq-panel" aria-labelledby="titulo-mes">
        <header class="dash-panel__cabecera sm-mes">
          <a class="btn btn--contorno btn--chico" href="/agenda?mes=<%= mesAnterior %>&lista=<%= lista %>" aria-label="Mes anterior">←</a>
          <h2 class="dash-panel__titulo sm-mes__titulo" id="titulo-mes"><%= nombreMes %></h2>
          <a class="btn btn--contorno btn--chico" href="/agenda?mes=<%= mesSiguiente %>&lista=<%= lista %>" aria-label="Mes siguiente">→</a>
        </header>
        <div class="sm-calendario" role="grid" aria-labelledby="titulo-mes">
          <% ['L', 'M', 'M', 'J', 'V', 'S', 'D'].forEach(function (d) { %><span class="sm-calendario__cabecera" aria-hidden="true"><%= d %></span><% }) %>
          <% celdas.forEach(function (fecha) { %>
            <% if (!fecha) { %><span class="sm-calendario__vacio"></span><% } else {
                 const conPartido = diasConPartido.has(fecha); %>
              <a class="sm-calendario__dia <%= conPartido ? 'sm-calendario__dia--partido' : '' %> <%= fecha === hoy ? 'sm-calendario__dia--hoy' : '' %> <%= fecha === dia ? 'sm-calendario__dia--elegido' : '' %>"
                 href="/agenda?mes=<%= mes %>&dia=<%= fecha %>&lista=<%= lista %>"
                 aria-label="<%= diaLargo.format(new Date(fecha + 'T00:00:00Z')) %><%= conPartido ? ', con partido' : '' %>"><%= Number(fecha.slice(8)) %></a>
            <% } %>
          <% }) %>
        </div>
        <% if (!hayEnElMes) { %><p class="dash-panel__nota">No tienes partidos en <%= nombreMes %>.</p><% } %>

        <% if (dia) { %>
          <h3 class="sm-subtitulo"><%= diaLargo.format(new Date(dia + 'T00:00:00Z')) %></h3>
          <% if (delDia.length === 0) { %>
            <p class="dash-panel__nota">No hay partidos este día.</p>
          <% } else { %>
            <ul class="sm-filas">
              <% delDia.forEach(function (p) { const f = fila(p); %>
                <li class="sm-fila <%= p.cancelado ? 'sm-fila--inactiva' : '' %>">
                  <a href="/partidos/<%= p.id %>"><%= p.desafiante %> vs <%= p.desafiado %></a>
                  <span><%= p.hora %> · <%= p.cancha %></span>
                  <span class="sm-estado <%= p.cancelado ? 'sm-estado--inactivo' : 'sm-rol' %>"><%= f.estado %></span>
                </li>
              <% }) %>
            </ul>
          <% } %>
        <% } %>
      </section>

      <section class="dash-panel eq-panel" aria-labelledby="titulo-lista">
        <h2 class="solo-lectores" id="titulo-lista">Lista de partidos</h2>
        <nav class="sm-pestanas sm-pestanas--chicas" aria-label="Próximos o pasados">
          <a class="sm-pestanas__item <%= lista === 'proximos' ? 'sm-pestanas__item--activa' : '' %>" href="/agenda?mes=<%= mes %>&lista=proximos">Próximos</a>
          <a class="sm-pestanas__item <%= lista === 'pasados' ? 'sm-pestanas__item--activa' : '' %>" href="/agenda?mes=<%= mes %>&lista=pasados">Pasados</a>
        </nav>
        <% if (listado.length === 0) { %>
          <div class="sm-vacio">
            <p class="dash-panel__nota"><%= lista === 'proximos' ? 'No tienes partidos programados.' : 'Aún no hay partidos pasados.' %></p>
            <% if (lista === 'proximos') { %><a class="btn btn--contorno btn--chico" href="/desafios">Ver desafíos</a><% } %>
          </div>
        <% } else { %>
          <ul class="sm-filas">
            <% listado.forEach(function (p) { const f = fila(p); %>
              <li class="sm-fila <%= p.cancelado ? 'sm-fila--inactiva' : '' %>">
                <a href="/partidos/<%= p.id %>"><%= p.desafiante %> vs <%= p.desafiado %></a>
                <span><%= f.dia %> · <%= p.hora %></span>
                <span class="sm-estado <%= p.cancelado ? 'sm-estado--inactivo' : 'sm-rol' %>"><%= f.estado %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </div>
  </div>
</section>

<%- include('../partials/dock', { activo: 'calendario' }) %>

<%- include('../partials/footer') %>
