<%- include('../partials/header') %>


<%
  const inscritos = misEquipos.filter((e) => e.inscrito);
  const disponibles = misEquipos.filter((e) => !e.inscrito && e.juegaModalidad);
  const otraModalidad = misEquipos.filter((e) => !e.inscrito && !e.juegaModalidad);
  // Inscripciones abiertas o con cupos completos y dentro de la fecha límite (comprobación perezosa del plazo).
  const enInscripcion = torneo.conInscripciones && !torneo.inscripcionVencida;
  const conPago = torneo.precio > 0;
  const esLlave = torneo.formato === 'relampago';
  const porcentaje = Math.round(100 * torneo.inscritos / torneo.cantidadEquipos);
  const faltan = torneo.cuposLibres;
  // Inscripción: con un equipo que juega la modalidad se abre el modal; si ninguno la juega, el botón
  // queda deshabilitado y cada equipo trae "Habilitar <modalidad>" (un clic, sin salir del torneo).
  const puedeInscribir = enInscripcion && faltan > 0 && disponibles.length > 0;
  const bloqueadoModalidad = enInscripcion && faltan > 0 && disponibles.length === 0 && otraModalidad.length > 0;
  // Pestaña por defecto: el cuadrante (vacío mientras se llenan los cupos, con resultados después)
  const pestanaInicial = 'cuadrante';
  // Eliminación directa: la cabecera es solo "Volver" y el nombre. Mientras hay inscripciones sigue el panel
  // con las acciones (inscribir, retirar, habilitar modalidad); después la llave ocupa todo el ancho.
  const conPanel = !esLlave || enInscripcion;
%>
<section class="eq trn">
  <div class="contenedor <%= conPanel ? '' : 'trn-contenedor--ancho' %>">
    <div class="trn-grid <%= conPanel ? '' : 'trn-grid--ancha' %>">
      <!-- Columna izquierda: resumen e inscripción -->
      <aside class="trn-lateral revelar">
        <%- include('../partials/boton-volver', { fallbackUrl: '/torneos' }) %>
        <h1 class="trn-titulo"><%= torneo.nombre %></h1>
        <% if (!esLlave) { %>
          <p class="trn-etiquetas">
            <span class="sm-rol"><%= torneo.formatoTexto %></span>
            <span class="sm-rol"><%= torneo.modalidad %></span>
            <span class="sm-estado sm-estado--torneo-<%= torneo.estado %>"><%= torneo.estadoTexto %></span>
          </p>
          <% if (enInscripcion && torneo.fechaInicio) { %>
            <p class="trn-fecha">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5.5" width="16" height="14" rx="2.5" /><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" /></svg>
              Inicia el <%= torneo.fechaInicioTexto.corta %><%= torneo.horaInicio ? ` · ${torneo.horaInicio} hrs` : '' %>
            </p>
          <% } %>
        <% } %>

        <% if (conPanel) { %>
        <div class="dash-panel eq-panel trn-energia" id="inscripcion">
          <% if (!esLlave) { %>
            <div class="trn-energia__cabecera">
              <span class="trn-energia__etiqueta">Cupos</span>
              <span class="trn-num trn-energia__cuenta"><strong><%= torneo.inscritos %></strong>/<%= torneo.cantidadEquipos %></span>
            </div>
            <div class="trn-energia__barra <%= enInscripcion ? 'trn-energia__barra--cargando' : '' %>" role="progressbar"
                 aria-valuemin="0" aria-valuemax="<%= torneo.cantidadEquipos %>" aria-valuenow="<%= torneo.inscritos %>" aria-label="Cupos llenos"
                 style="--segmentos: <%= torneo.cantidadEquipos %>">
              <span class="trn-energia__relleno" style="width: <%= porcentaje %>%"></span>
            </div>
            <p class="trn-energia__texto">
              <% if (!enInscripcion) { %>
                <%= torneo.conInscripciones ? 'Inscripciones cerradas' : torneo.estadoTexto %>
              <% } else if (faltan === 0) { %>
                ¡Cupos completos! El torneo está por comenzar
              <% } else { %>
                <span class="trn-num"><%= faltan === 1 ? 'Falta 1 equipo' : `Faltan ${faltan} equipos` %></span> para el inicio
              <% } %>
            </p>
          <% } %>

          <% inscritos.forEach(function (e) { %>
            <form class="trn-mi-equipo" action="/torneos/<%= torneo.id %>/retirar/<%= e.id %>" method="POST"
                  data-confirmar="Su cupo quedará libre para otro equipo." data-confirmar-titulo="¿Retirar a <%= e.nombre %> del torneo?" data-confirmar-boton="Retirar">
              <span class="trn-mi-equipo__check" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              </span>
              <span class="trn-mi-equipo__nombre"><strong><%= e.nombre %></strong><small>Inscrito</small></span>
              <% if (enInscripcion && !conPago) { %>
                <button type="submit" class="trn-btn-retirar">Retirar</button>
              <% } %>
            </form>
          <% }) %>

          <% if (enInscripcion) { %>
            <p class="dash-panel__nota">Inscripción: <strong><%= torneo.precioTexto %></strong> por equipo · hasta el <%= torneo.fechaLimiteTexto.corta || 'inicio' %>.</p>
            <% if (faltan === 0) { %>
              <p class="dash-panel__nota">No quedan cupos.</p>
            <% } else if (puedeInscribir) { %>
              <button type="button" class="btn btn--verde btn--bloque trn-cta" data-abrir-inscripcion>Inscribir mi equipo</button>
            <% } else if (bloqueadoModalidad) { %>
              <div class="trn-requisito">
                <button type="button" class="btn btn--verde btn--bloque trn-cta" disabled aria-describedby="trn-requisito-texto">Inscribir mi equipo</button>
                <p class="trn-requisito__texto" id="trn-requisito-texto">
                  <%= inscritos.length > 0 ? 'Tus otros equipos' : (otraModalidad.length === 1 ? 'Tu equipo' : 'Tus equipos') %>
                  no <%= otraModalidad.length === 1 ? 'juega' : 'juegan' %> <strong><%= torneo.modalidad %></strong>. Habilítala con un clic para inscribirlo:
                </p>
                <% otraModalidad.forEach(function (e) { %>
                  <form class="trn-requisito__fila" action="/torneos/<%= torneo.id %>/habilitar-modalidad" method="POST">
                    <input type="hidden" name="id_equipo" value="<%= e.id %>" />
                    <span class="trn-requisito__nombre"><%= e.nombre %></span>
                    <button type="submit" class="btn btn--contorno btn--chico">Habilitar <%= torneo.modalidad %></button>
                  </form>
                <% }) %>
                <a class="trn-requisito__enlace" href="/mi-equipo?equipo=<%= otraModalidad[0].id %>">Ir al panel de mi equipo →</a>
              </div>
            <% } else if (misEquipos.length === 0) { %>
              <p class="dash-panel__nota">Solo el capitán puede inscribir a su equipo. <a href="/crear-equipo">Crea un equipo</a> o pídele a tu capitán que lo inscriba.</p>
            <% } %>
          <% } %>
        </div>
        <% } %>
      </aside>

      <!-- Columna derecha: pestañas (Información | Equipos inscritos | Cuadrante) -->
      <div class="trn-principal revelar <%= pestanaInicial === 'cuadrante' ? 'is-wide' : 'is-narrow' %>" data-pestanas>
        <div class="trn-pestanas" role="tablist" aria-label="Secciones del torneo">
          <% [['informacion', 'Información'], ['equipos', 'Equipos inscritos'], ['cuadrante', 'Cuadrante']].forEach(function ([clave, texto]) { %>
            <button type="button" class="trn-pestana" role="tab" id="pestana-<%= clave %>" aria-controls="panel-<%= clave %>"
                    aria-selected="<%= clave === pestanaInicial %>" tabindex="<%= clave === pestanaInicial ? 0 : -1 %>">
              <%= texto %><% if (clave === 'equipos') { %> <span class="trn-num trn-pestana__cuenta"><%= torneo.inscritos %></span><% } %>
            </button>
          <% }) %>
        </div>

        <div class="trn-panel" role="tabpanel" id="panel-informacion" aria-labelledby="pestana-informacion" <%= pestanaInicial === 'informacion' ? '' : 'hidden' %>>
          <%- include('../partials/torneo-ficha', { torneo }) %>
          <% if (puedeInscribir) { %>
            <button type="button" class="btn btn--verde btn--bloque btn--xl trn-cta trn-cta--info" data-abrir-inscripcion>Inscribir equipo</button>
          <% } else if (bloqueadoModalidad) { %>
            <p class="dash-panel__nota trn-cta-nota">Para inscribirte, tu equipo debe jugar <%= torneo.modalidad %>. <a href="#inscripcion">Habilítala desde el panel de inscripción</a>.</p>
          <% } %>
        </div>

        <div class="trn-panel" role="tabpanel" id="panel-equipos" aria-labelledby="pestana-equipos" hidden>
          <% if (torneo.equipos.length > 0) { %>
            <ul class="sm-equipos-torneo trn-equipos">
              <% torneo.equipos.forEach(function (e) { %>
                <li class="<%= misEquipos.some((m) => m.id === e.id) ? 'trn-equipos__mio' : '' %>">
                  <span class="dash-equipo__escudo" aria-hidden="true"><%- include('../partials/escudo-equipo', { equipo: e }) %></span>
                  <a href="/equipos/<%= e.id %>"><%= e.nombre %></a>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="dash-panel__nota">Todavía no hay equipos inscritos. ¡Sé el primero!</p>
          <% } %>
          <% if (puedeInscribir) { %>
            <div class="trn-cupo-libre">
              <span class="trn-cupo-libre__texto">
                <span class="trn-num"><%= faltan === 1 ? 'Queda 1 cupo' : `Quedan ${faltan} cupos` %></span> en este torneo
              </span>
              <button type="button" class="btn btn--verde trn-cta" data-abrir-inscripcion>Inscribir a mi equipo aquí</button>
            </div>
          <% } %>
        </div>

        <div class="trn-panel trn-panel--cuadrante" role="tabpanel" id="panel-cuadrante" aria-labelledby="pestana-cuadrante" <%= pestanaInicial === 'cuadrante' ? '' : 'hidden' %>>
          <% if (enInscripcion && esLlave) { %>
            <%- include('../partials/torneo-cuadrante', { torneo, resaltar: misEquipos.map((e) => e.id) }) %>
          <% } else if (enInscripcion) { %>
            <div class="trn-vacio">
              <div class="trn-vacio__tabla" aria-hidden="true">
                <% for (let c = 0; c < Math.min(torneo.cantidadEquipos, 8); c++) { %>
                  <span class="trn-vacio__cupo <%= c < torneo.inscritos ? 'trn-vacio__cupo--lleno' : '' %>" style="--i: <%= c %>"></span>
                <% } %>
              </div>
              <p class="trn-vacio__texto">
                El fixture se generará automáticamente cuando se llenen los
                <span class="trn-num"><%= torneo.cantidadEquipos %></span> cupos
                (<%= torneo.emparejamiento === 'llegada' ? 'fecha 1 por orden de llegada' : 'cruces por tómbola' %>)
              </p>
            </div>
          <% } else { %>
            <%- include('../partials/torneo-competencia', { torneo, admin: false, resaltar: misEquipos.map((e) => e.id) }) %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (victoria) { %>
  <!-- Modal de victoria: torneo-detalle.js lo abre la primera vez que el capitán campeón entra al torneo.
       Íconos de Lucide en línea (Trophy, Clock, Share2, CheckCircle). -->
  <div class="modal vic" hidden data-modal-victoria data-torneo="<%= torneo.id %>"
       data-compartir-texto="¡<%= victoria.equipo %> es campeón de <%= torneo.nombre %> en SearchMatch! 🏆">
    <div class="vic__caja" role="dialog" aria-modal="true" aria-labelledby="vic-titulo" aria-describedby="vic-subtitulo">
      <div class="vic__rayos" aria-hidden="true"></div>
      <div class="vic__confeti" aria-hidden="true">
        <% for (let i = 0; i < 28; i++) { %><span style="--x: <%= (i * 37) % 100 %>%; --d: <%= ((i * 7) % 10) / 4 %>s; --t: <%= 3 + (i % 4) * 0.6 %>s; --r: <%= (i * 53) % 360 %>deg"></span><% } %>
      </div>

      <div class="vic__contenido">
        <span class="vic__trofeo" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" /></svg>
        </span>
        <h2 class="vic__titulo" id="vic-titulo">¡Campeones!</h2>
        <p class="vic__subtitulo" id="vic-subtitulo"><strong><%= victoria.equipo %></strong> ganó el <%= torneo.nombre %></p>

        <% if (victoria.monto) { %>
          <p class="vic__premio"><small>Premio</small><strong class="trn-num"><%= victoria.monto %> <span>CLP</span></strong></p>
          <p class="vic__pago">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            <span>El premio está siendo procesado. Se abonará en tu cuenta bancaria en un plazo de <strong>24 a 48 horas hábiles</strong>.</span>
          </p>
        <% } %>

        <div class="vic__acciones">
          <button type="button" class="vic__btn vic__btn--principal" data-cerrar-victoria>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
            Entendido
          </button>
          <button type="button" class="vic__btn vic__btn--secundario" data-compartir-victoria>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" x2="15.42" y1="13.51" y2="17.49" /><line x1="15.41" x2="8.59" y1="6.51" y2="10.49" /></svg>
            <span data-compartir-etiqueta>Compartir logro</span>
          </button>
        </div>
      </div>
    </div>
  </div>
<% } %>

<% if (puedeInscribir) { %>
  <!-- Modal "Inscribir equipo": elegir equipo y aceptar las reglas (torneo-detalle.js lo abre) -->
  <div class="modal modal--vidrio" hidden data-modal-inscripcion>
    <div class="modal__caja" role="dialog" aria-modal="true" aria-labelledby="modal-inscripcion-titulo">
      <h2 class="modal__titulo" id="modal-inscripcion-titulo">Inscribir en <span class="texto-verde"><%= torneo.nombre %></span></h2>
      <p class="modal__texto">
        <%= faltan === 1 ? 'Queda 1 cupo' : `Quedan ${faltan} cupos` %>. Elige el equipo y confirma las reglas.
      </p>
      <form class="modal__form" action="/torneos/<%= torneo.id %>/inscribir" method="POST">
        <label class="modal__campo">
          <span>Equipo</span>
          <select name="id_equipo" required>
            <% disponibles.forEach(function (e) { %><option value="<%= e.id %>"><%= e.nombre %></option><% }) %>
          </select>
        </label>
        <div class="trn-reglas">
          <p class="trn-reglas__titulo">Reglas del torneo</p>
          <ul class="trn-reglas__lista">
            <li><%= torneo.formatoTexto %> de <%= torneo.modalidad %> con <%= torneo.cantidadEquipos %> equipos.</li>
            <li>
              <%= torneo.emparejamiento === 'llegada'
                ? 'Cruces por orden de llegada: 1° inscrito vs 2°, 3° vs 4°…'
                : 'Cruces por tómbola: se sortean cuando se llenen los cupos.' %>
            </li>
            <li>Se juega en <%= torneo.recinto %> · <%= torneo.cancha %><%= torneo.comuna ? ` (${torneo.comuna})` : '' %>.</li>
            <li>Puedes retirar a tu equipo mientras las inscripciones sigan abiertas: su cupo queda libre.</li>
            <li>El torneo empieza cuando se llenan los cupos; desde ahí ya no podrás retirarlo.</li>
          </ul>
        </div>
        <label class="trn-reglas__acepto">
          <input type="checkbox" name="acepto_reglas" value="si" required />
          <span>Acepto las reglas del torneo</span>
        </label>
        <div class="modal__acciones">
          <button type="button" class="btn btn--contorno" data-cerrar-modal>Cancelar</button>
          <button type="submit" class="btn btn--verde">Confirmar inscripción</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<p class="panel-aviso <%= aviso ? 'panel-aviso--visible' : '' %>" role="status" aria-live="polite" data-aviso><%= aviso || '' %></p>

<%- include('../partials/dock', { activo: 'torneos' }) %>

<%- include('../partials/footer') %>
