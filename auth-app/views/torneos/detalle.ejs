<%- include('../partials/header') %>

<%- include('../partials/fondo-cyber', { variante: 'perspectiva' }) %>

<%
  const inscritos = misEquipos.filter((e) => e.inscrito);
  const disponibles = misEquipos.filter((e) => !e.inscrito && e.juegaModalidad);
  const otraModalidad = misEquipos.filter((e) => !e.inscrito && !e.juegaModalidad);
%>
<section class="eq">
  <div class="contenedor">
    <header class="eq-cabecera revelar">
      <div class="eq-cabecera__texto">
        <%- include('../partials/boton-volver', { fallbackUrl: '/torneos' }) %>
        <h1 class="eq-cabecera__titulo"><%= torneo.nombre %></h1>
        <p class="eq-cabecera__stats"><%= torneo.formatoTexto %> · <%= torneo.modalidad %></p>
      </div>
    </header>

    <%- include('../partials/torneo-ficha', { torneo }) %>

    <% if (torneo.estado === 'inscripcion') { %>
      <div class="dash-panel eq-panel">
        <h2 class="dash-panel__titulo">Inscripciones (<%= torneo.inscritos %>/<%= torneo.cantidadEquipos %>)</h2>
        <div class="sm-cupos" role="progressbar" aria-valuemin="0" aria-valuemax="<%= torneo.cantidadEquipos %>" aria-valuenow="<%= torneo.inscritos %>" aria-label="Cupos llenos">
          <span class="sm-cupos__relleno" style="width: <%= Math.round(100 * torneo.inscritos / torneo.cantidadEquipos) %>%"></span>
        </div>
        <p class="dash-panel__nota">El torneo empieza cuando se llenen los <%= torneo.cantidadEquipos %> cupos.</p>

        <% inscritos.forEach(function (e) { %>
          <form class="sm-inscripcion" action="/torneos/<%= torneo.id %>/retirar/<%= e.id %>" method="POST"
                data-confirmar="Su cupo quedará libre para otro equipo." data-confirmar-titulo="¿Retirar a <%= e.nombre %> del torneo?" data-confirmar-boton="Retirar">
            <span>✅ <strong><%= e.nombre %></strong> está inscrito.</span>
            <button type="submit" class="btn btn--contorno btn--chico sm-btn-peligro">Retirar</button>
          </form>
        <% }) %>

        <% if (torneo.cuposLibres === 0) { %>
          <p class="dash-panel__nota">No quedan cupos.</p>
        <% } else if (disponibles.length > 0) { %>
          <form class="sm-inscripcion" action="/torneos/<%= torneo.id %>/inscribir" method="POST">
            <% if (disponibles.length === 1) { %>
              <input type="hidden" name="id_equipo" value="<%= disponibles[0].id %>" />
              <button type="submit" class="btn btn--verde">Inscribir a <%= disponibles[0].nombre %></button>
            <% } else { %>
              <label for="id_equipo">Equipo</label>
              <select id="id_equipo" name="id_equipo" required>
                <% disponibles.forEach(function (e) { %><option value="<%= e.id %>"><%= e.nombre %></option><% }) %>
              </select>
              <button type="submit" class="btn btn--verde">Inscribir equipo</button>
            <% } %>
          </form>
        <% } else if (otraModalidad.length > 0) { %>
          <p class="dash-panel__nota">Tus equipos no juegan <%= torneo.modalidad %>. Agrega esa modalidad en el panel de tu equipo para inscribirlo.</p>
        <% } else if (misEquipos.length === 0) { %>
          <p class="dash-panel__nota">Solo el capitán puede inscribir a su equipo. <a href="/crear-equipo">Crea un equipo</a> o pídele a tu capitán que lo inscriba.</p>
        <% } %>

        <% if (torneo.equipos.length > 0) { %>
          <h3 class="sm-subtitulo">Equipos inscritos</h3>
          <ul class="sm-equipos-torneo">
            <% torneo.equipos.forEach(function (e) { %>
              <li>
                <span class="dash-equipo__escudo" aria-hidden="true"><%- include('../partials/escudo-equipo', { equipo: e }) %></span>
                <a href="/equipos/<%= e.id %>"><%= e.nombre %></a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    <% } else { %>
      <%- include('../partials/torneo-competencia', { torneo, admin: false, resaltar: misEquipos.map((e) => e.id) }) %>
    <% } %>
  </div>
</section>

<p class="panel-aviso <%= aviso ? 'panel-aviso--visible' : '' %>" role="status" aria-live="polite" data-aviso><%= aviso || '' %></p>

<%- include('../partials/dock', { activo: 'torneos' }) %>

<%- include('../partials/footer') %>
