<%- include('partials/header') %>

<%- include('partials/fondo-cyber', { variante: 'perspectiva' }) %>
<%
  // Texto del botón cuando ya no se puede pedir unirse
  const estados = { capitan: 'Eres el capitán', miembro: 'Ya eres parte', pendiente: 'Solicitud enviada ✓' };
%>

<!-- Directorio de equipos. Datos de la tabla "equipo";
     "Solicitar unirme" guarda una fila pendiente en solicitud_union_equipo (equipo.js lo envía sin recargar). -->
<section class="eq">
  <div class="contenedor">
    <header class="eq-cabecera revelar">
      <div class="eq-cabecera__texto">
        <%- include('partials/boton-volver') %>
        <h1 class="eq-cabecera__titulo">Directorio de Equipos</h1>
        <p class="eq-cabecera__stats">Encuentra un equipo cerca de ti y envía tu solicitud</p>
      </div>
      <div class="eq-cabecera__acciones">
        <a class="btn btn--contorno btn--grande" href="/solicitudes">Mis solicitudes</a><%# NUEVO: PE-011 %>
        <% if (tieneEquipo) { %>
          <a class="btn btn--contorno btn--grande" href="/mis-equipos">Mis equipos</a>
        <% } %>
        <% if (puedeCrear) { %>
          <!-- Solo cuentas de capitán (no las de jugador); quien crea el equipo queda como su capitán -->
          <a class="btn btn--verde btn--grande" href="/crear-equipo">
            <span aria-hidden="true">+</span> Crear equipo
          </a>
        <% } %>
        <%# CORRECCIÓN: regla 5 — si no puede crear más equipos, se explica el límite (antes solo se ocultaba el botón) %>
        <% if (locals.avisoLimite) { %>
          <p class="sm-aviso-limite" role="note"><%= avisoLimite %></p>
        <% } %>
      </div>
    </header>

    <%# NUEVO: PE-021 — equipos que buscan jugadores, con las posiciones y el nivel %>
    <%- include('partials/sm-equipos-buscan', { equiposQueBuscan: locals.equiposQueBuscan || [] }) %>

    <% if (equipos.length === 0) { %>
      <div class="dash-panel eq-panel revelar">
        <p class="dash-panel__nota">
          <%= puedeCrear
            ? 'Todavía no hay equipos registrados. ¡Crea el primero y empieza a recibir jugadores!'
            : 'Todavía no hay equipos registrados. Vuelve pronto para enviar tu solicitud.' %>
        </p>
      </div>
    <% } else { %>
      <!-- Buscador: equipo.js filtra las tarjetas por nombre o comuna mientras se escribe -->
      <label class="eq-buscador revelar">
        <svg class="eq-buscador__icono" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
        <span class="solo-lectores">Buscar equipo</span>
        <input class="eq-buscador__input" type="search" placeholder="Buscar por nombre o comuna" autocomplete="off" data-buscar-equipo>
      </label>

      <!-- Mismas tarjetas que Mis equipos (.eq-mis en equipo.css): el equipo del capitán brilla en verde -->
      <ul class="eq-mis-grilla eq-mis-grilla--directorio">
        <% equipos.forEach(function (equipo) { const capitan = equipo.relacion === 'capitan'; %>
          <li class="eq-mis <%= capitan ? 'eq-mis--capitan' : '' %>" data-busqueda="<%= [equipo.nombre, equipo.zona].filter(Boolean).join(' ') %>">
            <div class="eq-mis__arriba">
              <span class="eq-mis__escudo" aria-hidden="true"><%- include('partials/escudo-equipo', { equipo }) %></span>
              <% if (capitan) { %>
                <span class="eq-mis__rol eq-mis__rol--capitan">Capitán</span>
              <% } else if (equipo.relacion === 'miembro') { %>
                <span class="eq-mis__rol">Jugador</span>
              <% } %>
              <a class="eq-mis__enlace" href="/equipos/<%= equipo.id %>">Ver ficha</a><%# NUEVO: PE-009 %>
            </div>

            <h2 class="eq-mis__nombre" title="<%= equipo.nombre %>"><%= equipo.nombre %></h2>

            <ul class="eq-mis__datos">
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                <%= equipo.zona || 'Sin comuna' %>
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7l4 3-1.5 4.5h-5L8 10z" /></svg>
                <%= equipo.modalidad || 'Sin tipo de fútbol' %>
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V14M10 20V9M16 20V4" /></svg>
                <%= equipo.nivel || 'Nivel sin definir' %>
              </li>
            </ul>

            <% if (capitan) { %>
              <a class="eq-mis__accion eq-mis__accion--principal" href="/mi-equipo?equipo=<%= equipo.id %>">
                Administrar equipo
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.4-7.5 9.5-4.3-1.1-7.5-4.9-7.5-9.5V6z" /><path d="M9 12l2 2 4-4" /></svg>
              </a>
            <% } else if (equipo.relacion) { %>
              <button type="button" class="eq-mis__accion" disabled><%= estados[equipo.relacion] %></button>
            <% } else { %>
              <form class="eq-mis__form" action="/equipos/<%= equipo.id %>/unirme" method="POST" data-unirme data-equipo="<%= equipo.nombre %>">
                <button type="submit" class="eq-mis__accion eq-mis__accion--principal">Solicitar unirme</button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ul>
      <p class="dash-panel__nota eq-sin-resultados" data-sin-resultados hidden>No hay equipos que coincidan con tu búsqueda.</p>
    <% } %>
  </div>
</section>

<!-- Modal de "Solicitar unirme": el mensaje para el capitán (equipo.js lo abre y envía la solicitud) -->
<div class="modal" hidden data-modal-union>
  <div class="modal__caja" role="dialog" aria-modal="true" aria-labelledby="modal-union-titulo">
    <h2 class="modal__titulo" id="modal-union-titulo">Unirme a <span class="texto-verde" data-modal-equipo></span></h2>
    <p class="modal__texto">Cuéntale al capitán quién eres: lo verá junto a tu perfil antes de aceptarte.</p>
    <form class="modal__form" data-form-union novalidate>
      <label class="modal__campo">
        <span>Mensaje para el capitán</span>
        <textarea name="mensaje" rows="3" maxlength="<%= LONGITUD_MENSAJE %>" required
                  placeholder="Ej. Juego de lateral derecho y puedo los fines de semana."></textarea>
      </label>
      <p class="modal__error" role="alert" hidden data-modal-error></p>
      <div class="modal__acciones">
        <button type="button" class="btn btn--contorno" data-cerrar-modal>Cancelar</button>
        <button type="submit" class="btn btn--verde">Enviar solicitud</button>
      </div>
    </form>
  </div>
</div>

<!-- Aviso tras enviar la solicitud (equipo.js lo esconde a los pocos segundos) -->
<p class="panel-aviso <%= aviso ? 'panel-aviso--visible' : '' %>" role="status" aria-live="polite" data-aviso><%= aviso || '' %></p>

<%- include('partials/dock', { activo: 'equipos' }) %>

<%- include('partials/footer') %>
