<%- include('partials/header') %>

<section class="auth">
  <div class="tarjeta auth__tarjeta">
    <span class="etiqueta-verde">Bienvenido de vuelta</span>
    <h1 class="auth__titulo">Iniciar sesión</h1>
    <p class="auth__subtitulo">Entra para ver tus partidos, equipos y reservas.</p>

    <!-- Mensajes de aviso (correo por confirmar, sesión cerrada, etc.) -->
    <% if (aviso) { %>
      <div class="alerta alerta--exito" role="status"><%= aviso %></div>
    <% } %>

    <!-- Errores de validación o de Supabase, ya traducidos -->
    <% if (errores && errores.length > 0) { %>
      <div class="alerta alerta--error" role="alert">
        <ul>
          <% errores.forEach(function(error) { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/login" method="POST" class="formulario" novalidate>
      <div class="campo">
        <label for="correo">Correo</label>
        <input
          type="email"
          id="correo"
          name="correo"
          placeholder="tucorreo@ejemplo.com"
          value="<%= datos.correo || '' %>"
          autocomplete="email"
          required
        />
      </div>

      <div class="campo">
        <label for="password">Contraseña</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Tu contraseña"
          autocomplete="current-password"
          required
        />
      </div>

      <button type="submit" class="btn btn--verde btn--bloque btn--grande">ENTRAR <span aria-hidden="true">→</span></button>
    </form>

    <p class="auth__pie">¿No tienes cuenta? <a href="/registro">Regístrate aquí</a></p>
  </div>
</section>

<%- include('partials/footer') %>
