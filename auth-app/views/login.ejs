<%- include('partials/header') %>

<%- include('partials/fondo-cyber', { variante: 'pizarra' }) %>

<section class="auth auth--login">
  <%- include('partials/auth-marca', { titulo: 'La cancha te está <em>esperando</em>.' }) %>

  <div class="tarjeta auth__tarjeta">
    <span class="auth__filo" aria-hidden="true"></span>
    <!-- Cambiar entre login y registro -->
    <nav class="auth-pestanas auth-pestanas--login" aria-label="Elegir formulario">
      <span class="auth-pestanas__indicador" aria-hidden="true"></span>
      <a class="auth-pestanas__item auth-pestanas__item--activa" href="/login" aria-current="page">Iniciar sesión</a>
      <a class="auth-pestanas__item" href="/registro">Crear cuenta</a>
    </nav>

    <span class="etiqueta-verde">Bienvenido de vuelta</span>
    <h1 class="auth__titulo">Iniciar sesión</h1>
    <p class="auth__subtitulo">Entra para ver tus partidos, equipos y reservas.</p>

    <!-- Mensajes de aviso (correo por confirmar, sesión cerrada, etc.) -->
    <% if (aviso) { %>
      <div class="alerta alerta--exito" role="status"><%= aviso %></div>
    <% } %>

    <!-- data-validar: auth.js valida en el navegador y muestra el estado "cargando".
         La validación real sigue en el servidor (middlewares/validators.js). -->
    <form action="/login" method="POST" class="formulario" data-validar="login" novalidate>
      <div class="campo">
        <label for="correo">Correo</label>
        <div class="campo__control">
          <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
          <input
            type="email"
            id="correo"
            name="correo"
            placeholder="tucorreo@ejemplo.com"
            value="<%= datos.correo || '' %>"
            autocomplete="email"
            aria-describedby="correo-error"
            required
          />
        </div>
        <small class="campo__error" id="correo-error"></small>
      </div>

      <div class="campo">
        <label for="password">Contraseña</label>
        <div class="campo__control">
          <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Tu contraseña"
            autocomplete="current-password"
            aria-describedby="password-error"
            required
          />
          <!-- Mostrar / ocultar contraseña (auth.js). Sin JS queda oculto. -->
          <button type="button" class="campo__ojo" data-ver-password aria-controls="password" aria-pressed="false" aria-label="Mostrar contraseña">
            <svg class="campo__ojo-icono campo__ojo-icono--ver" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0" /><circle cx="12" cy="12" r="3" /></svg>
            <svg class="campo__ojo-icono campo__ojo-icono--ocultar" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.73 5.08a10.74 10.74 0 0 1 11.2 6.57 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-1.44 2.49" /><path d="M14.08 14.16a3 3 0 0 1-4.24-4.24" /><path d="M17.48 17.5a10.75 10.75 0 0 1-15.42-5.15 1 1 0 0 1 0-.7 10.75 10.75 0 0 1 4.45-5.14" /><path d="m2 2 20 20" /></svg>
          </button>
        </div>
        <small class="campo__error" id="password-error"></small>
      </div>

      <!-- NUEVO: AR-008 — enlace a la recuperación de contraseña -->
      <p class="sm-olvido"><a href="/recuperar">¿Olvidaste tu contraseña?</a></p>

      <button type="submit" class="btn btn--verde btn--bloque btn--grande auth-btn" data-ripple="claro" data-texto-cargando="ENTRANDO...">
        <span class="auth-btn__halo" aria-hidden="true"></span>
        <span class="btn__spinner" aria-hidden="true"></span>
        <span class="btn__texto">ENTRAR</span>
        <span class="btn__flecha" aria-hidden="true">→</span>
      </button>
    </form>

    <!-- Errores del servidor (credenciales incorrectas, Supabase...) o de auth.js -->
    <div class="alerta alerta--error" role="alert" data-alerta-errores <%= errores && errores.length > 0 ? '' : 'hidden' %>>
      <ul>
        <% (errores || []).forEach(function(error) { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>

    <p class="auth__pie">¿No tienes cuenta? <a href="/registro">Regístrate aquí</a></p>
  </div>
</section>

<%- include('partials/footer') %>
