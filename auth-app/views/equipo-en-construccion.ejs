<%- include('partials/header') %>

<section class="auth">
  <div class="tarjeta auth__tarjeta auth__tarjeta--ancha obra">
    <span class="badge obra__badge"><span class="badge__punto" aria-hidden="true"></span>En construcción</span>

    <!-- Escudo de capitán con un cono de entrenamiento -->
    <div class="obra__icono" aria-hidden="true">
      <svg class="obra__escudo" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round">
        <path d="M24 4l16 6v12c0 10.5-6.8 18.6-16 22-9.2-3.4-16-11.5-16-22V10z" />
        <path d="M24 13l2.4 4.8 5.3.8-3.8 3.7.9 5.2-4.8-2.5-4.8 2.5.9-5.2-3.8-3.7 5.3-.8z" fill="currentColor" stroke="none" />
      </svg>
      <svg class="obra__cono" viewBox="0 0 24 24">
        <path d="M10.2 3h3.6l5.4 16H4.8z" fill="#ff8a1f" />
        <path d="M8.6 9.2h6.8l.9 2.8H7.7zM6.8 14.6h10.4l.9 2.8H5.9z" fill="#fff" />
        <rect x="3" y="19" width="18" height="2.4" rx="1" fill="#ff8a1f" />
      </svg>
    </div>

    <h1 class="auth__titulo">Estamos armando el <span class="texto-verde">camarín</span> de los equipos</h1>
    <p class="auth__subtitulo">
      La sección para capitanes todavía está en el entrenamiento de pretemporada. Muy pronto podrás
      registrar tu escuadra y salir a la cancha con ella.
    </p>

    <p class="obra__lista-titulo">Lo que viene</p>
    <ul class="rol-tarjeta__lista obra__lista">
      <li>Registra tu equipo con su escudo y colores</li>
      <li>Invita a tu plantel y gestiónalo como capitán</li>
      <li>Reserva canchas y agenda partidos</li>
      <li>Desafía a equipos de tu nivel y de tu comuna</li>
    </ul>

    <p class="obra__nota">Te avisaremos a <strong><%= usuario.correo %></strong> cuando el camarín esté listo.</p>

    <!-- Cambia el rol a "jugador" y lleva al wizard del perfil -->
    <form action="/select-role" method="POST">
      <input type="hidden" name="rol" value="jugador" />
      <button type="submit" class="btn btn--verde btn--bloque btn--grande">
        Mientras tanto, crea tu carta de jugador <span aria-hidden="true">→</span>
      </button>
    </form>
    <a class="btn btn--contorno btn--bloque btn--grande obra__panel" href="/dashboard">Ir a mi panel</a>

    <p class="auth__pie">¿Te equivocaste? <a href="/select-role">Cambiar cómo uso Search Match</a></p>
  </div>
</section>

<%- include('partials/footer') %>
