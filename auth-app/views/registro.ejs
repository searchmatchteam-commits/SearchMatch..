<%- include('partials/header') %>

<section class="auth">
  <div class="tarjeta auth__tarjeta auth__tarjeta--ancha">
    <span class="etiqueta-verde">Únete a SearchMatch</span>
    <h1 class="auth__titulo">Crear cuenta</h1>
    <p class="auth__subtitulo">Toma menos de un minuto. Después podrás completar tu perfil de jugador.</p>

    <!-- Errores de validación (campos obligatorios, correo o teléfono inválidos,
         contraseñas que no coinciden, correo ya registrado...) -->
    <% if (errores && errores.length > 0) { %>
      <div class="alerta alerta--error" role="alert">
        <ul>
          <% errores.forEach(function(error) { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/registro" method="POST" class="formulario" novalidate>
      <div class="formulario__fila">
        <div class="campo">
          <label for="nombre">Nombre</label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            placeholder="Tu nombre"
            value="<%= datos.nombre || '' %>"
            autocomplete="given-name"
            maxlength="100"
            required
          />
        </div>

        <div class="campo">
          <label for="apellido">Apellido</label>
          <input
            type="text"
            id="apellido"
            name="apellido"
            placeholder="Tu apellido"
            value="<%= datos.apellido || '' %>"
            autocomplete="family-name"
            maxlength="100"
            required
          />
        </div>
      </div>

      <div class="campo">
        <label for="correo">Correo</label>
        <input
          type="email"
          id="correo"
          name="correo"
          placeholder="tucorreo@ejemplo.com"
          value="<%= datos.correo || '' %>"
          autocomplete="email"
          maxlength="150"
          required
        />
      </div>

      <div class="formulario__fila">
        <div class="campo">
          <label for="telefono">Teléfono (WhatsApp)</label>
          <input
            type="tel"
            id="telefono"
            name="telefono"
            placeholder="+56 9 1234 5678"
            value="<%= datos.telefono || '' %>"
            autocomplete="tel"
            inputmode="tel"
            data-telefono-cl
            required
          />
          <small class="campo__ayuda">Celular chileno: +56 9 XXXX XXXX.</small>
        </div>

        <div class="campo">
          <label for="fecha_nacimiento">Fecha de nacimiento</label>
          <!-- max = hoy: el calendario del navegador no deja elegir fechas futuras
               (la validación real está en middlewares/validators.js) -->
          <input
            type="date"
            id="fecha_nacimiento"
            name="fecha_nacimiento"
            value="<%= datos.fecha_nacimiento || '' %>"
            max="<%= new Date().toISOString().slice(0, 10) %>"
            autocomplete="bday"
            required
          />
        </div>
      </div>

      <div class="formulario__fila">
        <div class="campo">
          <label for="password">Contraseña</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Mínimo 8 caracteres"
            autocomplete="new-password"
            minlength="8"
            required
          />
        </div>

        <div class="campo">
          <label for="confirmar_password">Confirmar contraseña</label>
          <input
            type="password"
            id="confirmar_password"
            name="confirmar_password"
            placeholder="Repite tu contraseña"
            autocomplete="new-password"
            minlength="8"
            required
          />
        </div>
      </div>

      <button type="submit" class="btn btn--verde btn--bloque btn--grande">CREAR CUENTA <span aria-hidden="true">→</span></button>
    </form>

    <p class="auth__pie">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
  </div>
</section>

<%- include('partials/footer') %>
