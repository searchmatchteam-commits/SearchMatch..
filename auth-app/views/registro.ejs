<%- include('partials/header') %>

<section class="tarjeta">
  <h1 class="tarjeta__titulo">Crear cuenta</h1>

  <!-- Errores de validación (campos obligatorios, email inválido,
       contraseña corta o email ya registrado) -->
  <% if (errores && errores.length > 0) { %>
    <div class="alerta alerta--error">
      <ul>
        <% errores.forEach(function(error) { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/registro" method="POST" class="formulario" novalidate>
    <div class="campo">
      <label for="nombre">Nombre</label>
      <input
        type="text"
        id="nombre"
        name="nombre"
        placeholder="Tu nombre"
        value="<%= datos.nombre || '' %>"
        required
      />
    </div>

    <div class="campo">
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        placeholder="tucorreo@ejemplo.com"
        value="<%= datos.email || '' %>"
        required
      />
    </div>

    <div class="campo">
      <label for="password">Contraseña</label>
      <input
        type="password"
        id="password"
        name="password"
        placeholder="Mínimo 8 caracteres"
        minlength="8"
        required
      />
      <small class="campo__ayuda">Debe tener al menos 8 caracteres.</small>
    </div>

    <button type="submit" class="btn btn--primario btn--bloque">Registrarme</button>
  </form>

  <p class="tarjeta__pie">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
</section>

<%- include('partials/footer') %>
