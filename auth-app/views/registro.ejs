<%- include('partials/header') %>

<section class="auth">
  <div class="tarjeta auth__tarjeta auth__tarjeta--ancha">
    <span class="etiqueta-verde">Únete a SearchMatch</span>
    <h1 class="auth__titulo">Crear cuenta</h1>
    <p class="auth__subtitulo">Toma menos de un minuto. Después podrás completar tu perfil de jugador.</p>

    <!-- data-validar: auth.js valida en el navegador y muestra el estado "cargando".
         La validación real sigue en el servidor (middlewares/validators.js). -->
    <form action="/registro" method="POST" class="formulario" data-validar="registro" novalidate>
      <div class="formulario__fila">
        <div class="campo">
          <label for="nombre">Nombre</label>
          <div class="campo__control">
            <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4" /><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /></svg>
            <input
              type="text"
              id="nombre"
              name="nombre"
              placeholder="Tu nombre"
              value="<%= datos.nombre || '' %>"
              autocomplete="given-name"
              maxlength="100"
              aria-describedby="nombre-error"
              required
            />
          </div>
          <small class="campo__error" id="nombre-error"></small>
        </div>

        <div class="campo">
          <label for="apellido">Apellido</label>
          <div class="campo__control">
            <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4" /><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /></svg>
            <input
              type="text"
              id="apellido"
              name="apellido"
              placeholder="Tu apellido"
              value="<%= datos.apellido || '' %>"
              autocomplete="family-name"
              maxlength="100"
              aria-describedby="apellido-error"
              required
            />
          </div>
          <small class="campo__error" id="apellido-error"></small>
        </div>
      </div>

      <div class="campo">
        <label for="correo">Correo</label>
        <div class="campo__control">
          <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
          <input
            type="email"
            id="correo"
            name="correo"
            placeholder="tucorreo@ejemplo.com"
            value="<%= datos.correo || '' %>"
            autocomplete="email"
            maxlength="150"
            aria-describedby="correo-error"
            required
          />
        </div>
        <small class="campo__error" id="correo-error"></small>
      </div>

      <div class="formulario__fila">
        <div class="campo">
          <label for="telefono">Teléfono (WhatsApp)</label>
          <div class="campo__control">
            <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
            <input
              type="tel"
              id="telefono"
              name="telefono"
              placeholder="+56 9 1234 5678"
              value="<%= datos.telefono || '' %>"
              autocomplete="tel"
              inputmode="tel"
              data-telefono-cl
              aria-describedby="telefono-error"
              required
            />
          </div>
          <small class="campo__error" id="telefono-error"></small>
          <small class="campo__ayuda">Celular chileno: +56 9 XXXX XXXX.</small>
        </div>

        <div class="campo">
          <label for="fecha_nacimiento">Fecha de nacimiento</label>
          <!-- max = hoy: el calendario del navegador no deja elegir fechas futuras
               (la validación real está en middlewares/validators.js) -->
          <div class="campo__control">
            <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
            <input
              type="date"
              id="fecha_nacimiento"
              name="fecha_nacimiento"
              value="<%= datos.fecha_nacimiento || '' %>"
              max="<%= new Date().toISOString().slice(0, 10) %>"
              autocomplete="bday"
              aria-describedby="fecha_nacimiento-error"
              required
            />
          </div>
          <small class="campo__error" id="fecha_nacimiento-error"></small>
        </div>
      </div>

      <div class="formulario__fila">
        <div class="campo">
          <label for="password">Contraseña</label>
          <div class="campo__control">
            <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Mínimo 8 caracteres"
              autocomplete="new-password"
              minlength="8"
              aria-describedby="password-error"
              required
            />
            <!-- Mostrar / ocultar contraseña (auth.js). Sin JS queda oculto. -->
            <button type="button" class="campo__ojo" data-ver-password aria-controls="password" aria-pressed="false" aria-label="Mostrar contraseña">
              <svg class="campo__ojo-icono campo__ojo-icono--ver" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0" /><circle cx="12" cy="12" r="3" /></svg>
              <svg class="campo__ojo-icono campo__ojo-icono--ocultar" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.73 5.08a10.74 10.74 0 0 1 11.2 6.57 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-1.44 2.49" /><path d="M14.08 14.16a3 3 0 0 1-4.24-4.24" /><path d="M17.48 17.5a10.75 10.75 0 0 1-15.42-5.15 1 1 0 0 1 0-.7 10.75 10.75 0 0 1 4.45-5.14" /><path d="m2 2 20 20" /></svg>
            </button>
          </div>
          <small class="campo__error" id="password-error"></small>
        </div>

        <div class="campo">
          <label for="confirmar_password">Confirmar contraseña</label>
          <div class="campo__control">
            <svg class="campo__icono" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
            <input
              type="password"
              id="confirmar_password"
              name="confirmar_password"
              placeholder="Repite tu contraseña"
              autocomplete="new-password"
              minlength="8"
              aria-describedby="confirmar_password-error"
              required
            />
            <!-- Mostrar / ocultar contraseña (auth.js). Sin JS queda oculto. -->
            <button type="button" class="campo__ojo" data-ver-password aria-controls="confirmar_password" aria-pressed="false" aria-label="Mostrar contraseña">
              <svg class="campo__ojo-icono campo__ojo-icono--ver" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0" /><circle cx="12" cy="12" r="3" /></svg>
              <svg class="campo__ojo-icono campo__ojo-icono--ocultar" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.73 5.08a10.74 10.74 0 0 1 11.2 6.57 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-1.44 2.49" /><path d="M14.08 14.16a3 3 0 0 1-4.24-4.24" /><path d="M17.48 17.5a10.75 10.75 0 0 1-15.42-5.15 1 1 0 0 1 0-.7 10.75 10.75 0 0 1 4.45-5.14" /><path d="m2 2 20 20" /></svg>
            </button>
          </div>
          <small class="campo__error" id="confirmar_password-error"></small>
        </div>
      </div>

      <button type="submit" class="btn btn--verde btn--bloque btn--grande" data-texto-cargando="CREANDO CUENTA...">
        <span class="btn__spinner" aria-hidden="true"></span>
        <span class="btn__texto">CREAR CUENTA</span>
        <span class="btn__flecha" aria-hidden="true">→</span>
      </button>
    </form>

    <!-- Errores del servidor (correo ya registrado, contraseñas que no coinciden...) o de auth.js -->
    <div class="alerta alerta--error" role="alert" data-alerta-errores <%= errores && errores.length > 0 ? '' : 'hidden' %>>
      <ul>
        <% (errores || []).forEach(function(error) { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>

    <p class="auth__pie">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
  </div>
</section>

<%- include('partials/footer') %>
