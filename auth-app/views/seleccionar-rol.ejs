<%- include('partials/header') %>

<section class="rol rol--continuar">
  <header class="rol__cabecera">
    <span class="rol__eyebrow">SEARCH MATCH · REGISTRO</span>
    <h1 class="rol__titulo">Estás a un paso de jugar</h1>
    <p class="rol__subtitulo">A continuación te pediremos tus datos básicos para crear tu perfil.</p>
  </header>

  <!-- Por ahora no se elige rol: todos parten como jugador (rol oculto) y siguen a sus datos (/perfil-jugador).
       Se sigue guardando con POST porque requireRol pide un rol para entrar al resto de la app.
       rol.js solo muestra "Cargando..." y evita el doble envío. -->
  <form action="/select-role" method="POST" class="rol__formulario" data-seleccion-rol>
    <input type="hidden" name="rol" value="jugador" />

    <% if (errores && errores.length > 0) { %>
      <div class="alerta alerta--error rol__alerta" role="alert"><%= errores[0] %></div>
    <% } %>

    <button type="submit" class="btn btn--verde rol__boton" data-boton-rol>
      <span class="btn__texto">Siguiente: Mis datos</span>
      <span aria-hidden="true">→</span>
    </button>
  </form>
</section>

<%- include('partials/footer') %>
