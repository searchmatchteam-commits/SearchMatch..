<%- include('partials/header') %>
<%
  // Datos que perfil.js usa para dibujar la carta en un <canvas> (descargar / compartir).
  const datosCarta = {
    nombre: jugador.nombre,
    media: jugador.media,
    posicion: jugador.posicion.sigla,
    estadisticas: jugador.estadisticas.map(function (s) { return [s.sigla, s.valor]; }),
  };
%>

<section class="perfil">
  <!-- ============ COLUMNA IZQUIERDA: LA CARTA ============ -->
  <div class="perfil__carta">
    <!-- main.js inclina la carta (data-tilt) usando este contenedor como zona del mouse -->
    <div class="perfil__escenario">
      <div class="carta-jugador carta-jugador--neon carta-jugador--perfil" data-tilt data-carta="<%= JSON.stringify(datosCarta) %>">
        <div class="carta-jugador__marco">
          <div class="carta-jugador__cuerpo">
            <div class="carta-jugador__cabecera">
              <div class="carta-jugador__media">
                <span class="carta-jugador__numero"><%= jugador.media %></span>
                <span class="carta-jugador__posicion"><%= jugador.posicion.sigla %></span>
                <svg class="carta-jugador__bandera" viewBox="0 0 30 20" role="img" aria-label="Chile">
                  <rect width="30" height="10" fill="#fff" />
                  <rect y="10" width="30" height="10" fill="#d52b1e" />
                  <rect width="10" height="10" fill="#0039a6" />
                  <path d="M5 2.2l.66 2.03h2.13l-1.72 1.25.66 2.03L5 6.26 3.27 7.51l.66-2.03-1.72-1.25h2.13z" fill="#fff" />
                </svg>
                <svg class="carta-jugador__marca" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.8" />
                  <path d="M12 7.2l4.1 3-1.6 4.8h-5L7.9 10.2z" fill="currentColor" />
                  <path d="M12 7.2V2.3M16.1 10.2l4.6-1.5M14.5 15l2.9 4M9.5 15l-2.9 4M7.9 10.2L3.3 8.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              </div>

              <!-- Foto: silueta hasta que el usuario elija una imagen -->
              <div class="carta-jugador__foto">
                <img alt="" hidden data-foto-preview />
                <svg viewBox="0 0 24 24" aria-hidden="true" data-foto-silueta><circle cx="12" cy="9" r="4" /><path d="M4.5 21a7.5 7.5 0 0 1 15 0" /></svg>
                <label class="carta-jugador__subir" for="foto">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
                  Subir foto
                </label>
              </div>
            </div>

            <p class="carta-jugador__nombre"><%= jugador.nombre.toUpperCase() %></p>

            <dl class="carta-jugador__stats">
              <% jugador.estadisticas.forEach(function (s) { %>
                <div><dt><%= s.sigla %></dt><dd><%= s.valor %></dd></div>
              <% }) %>
            </dl>

            <span class="carta-jugador__brillo"></span>
          </div>
        </div>
      </div>
    </div>

    <input type="file" id="foto" accept="image/*" class="solo-lectores" data-foto-input />
  </div>

  <!-- ============ COLUMNA DERECHA: RESUMEN ============ -->
  <div class="perfil__info">
    <header class="perfil__cabecera">
      <span class="rol__eyebrow">SEARCH MATCH · PERFIL</span>
      <h1 class="perfil__titulo">Tu carta de jugador</h1>
      <p class="perfil__subtitulo">Así te verán otros jugadores al buscar partidos.</p>
    </header>

    <article class="perfil__tarjeta">
      <h2 class="perfil__tarjeta-titulo">Datos</h2>
      <dl class="perfil__datos">
        <div class="perfil__dato--ancho"><dt>Nombre completo</dt><dd><%= jugador.nombreCompleto %></dd></div>
        <div><dt>Posición</dt><dd><%= jugador.posicion.etiqueta %></dd></div>
        <div><dt>Edad</dt><dd><%= jugador.edad !== null ? jugador.edad + ' años' : '—' %></dd></div>
        <div><dt>Altura</dt><dd><%= jugador.altura ? jugador.altura + ' cm' : '—' %></dd></div>
        <div><dt>Peso</dt><dd><%= jugador.peso ? jugador.peso + ' kg' : '—' %></dd></div>
        <div><dt>Pie hábil</dt><dd><%= jugador.pieHabil %></dd></div>
        <div><dt>Nivel</dt><dd><%= jugador.nivel %></dd></div>
      </dl>
    </article>

    <article class="perfil__tarjeta">
      <h2 class="perfil__tarjeta-titulo">Estadísticas</h2>
      <ul class="barras">
        <% jugador.estadisticas.forEach(function (s) { %>
          <li class="barras__item">
            <span class="barras__sigla" title="<%= s.nombre %>"><%= s.sigla %></span>
            <span class="barras__track" role="meter" aria-label="<%= s.nombre %>" aria-valuemin="0" aria-valuemax="99" aria-valuenow="<%= s.valor %>">
              <span class="barras__relleno" style="--valor: <%= s.valor %>"></span>
            </span>
            <span class="barras__valor"><%= s.valor %></span>
          </li>
        <% }) %>
      </ul>
      <p class="perfil__nota">Tus estadísticas mejorarán con los partidos jugados y las valoraciones de tus compañeros.</p>
    </article>

    <div class="perfil__acciones">
      <label class="btn btn--verde btn--grande" for="foto">
        <svg class="btn__icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
        Subir foto
      </label>
      <a class="btn btn--contorno btn--grande" href="/perfil-jugador">Editar perfil</a>
    </div>

    <div class="perfil__enlaces">
      <button type="button" class="enlace-icono" data-descargar>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
        Descargar carta
      </button>
      <button type="button" class="enlace-icono" data-compartir>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5.5" r="2.5" /><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="18.5" r="2.5" /><path d="M8.2 10.8l7.6-4.1M8.2 13.2l7.6 4.1" /></svg>
        Compartir carta
      </button>
    </div>

    <p class="perfil__estado" role="status" aria-live="polite" data-estado></p>
  </div>
</section>

<%- include('partials/footer') %>
