<%- include('partials/header') %>

<section class="perfil">
  <!-- ============ COLUMNA IZQUIERDA: LA CARTA ============ -->
  <div class="perfil__carta">
    <%- include('partials/carta-jugador', { jugador, editor: false }) %>
  </div>

  <!-- ============ COLUMNA DERECHA: RESUMEN ============ -->
  <!-- Encabezado aparte: en escritorio va sobre la columna derecha y la carta queda al nivel de la primera tarjeta -->
  <header class="perfil__cabecera">
    <div class="perfil__volver"><%- include('partials/boton-volver') %></div>
    <span class="rol__eyebrow">SEARCH MATCH · PERFIL</span>
    <h1 class="perfil__titulo">Tu carta de jugador</h1>
    <p class="perfil__subtitulo">Así te verán otros jugadores al buscar partidos.</p>
  </header>

  <div class="perfil__info">
    <%- include('partials/perfil-resumen', { jugador, nota: 'Tus estadísticas cambian con las valoraciones de otros jugadores después de cada partido.' /* CORRECCIÓN: regla 8 */ }) %>

    <div class="perfil__acciones">
      <a class="btn btn--verde btn--grande" href="/perfil/editar">
        <svg class="btn__icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z" /><path d="M13.5 6.5l4 4" /></svg>
        Editar perfil
      </a>
    </div>

    <div class="perfil__enlaces">
      <button type="button" class="enlace-icono" data-descargar>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
        Descargar carta
      </button>
      <button type="button" class="enlace-icono" data-compartir>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5.5" r="2.5" /><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="18.5" r="2.5" /><path d="M8.2 10.8l7.6-4.1M8.2 13.2l7.6 4.1" /></svg>
        Compartir carta
      </button>
    </div>

    <p class="perfil__estado" role="status" aria-live="polite" data-estado></p>

    <!-- NUEVO: AR-012 / AR-009 / AR-010 — cuenta, contraseña y documentos, siempre a mano desde el perfil -->
    <nav class="sm-perfil-enlaces" aria-label="Mi cuenta">
      <a href="/cuenta">Mi cuenta</a>
      <a href="/cuenta/contrasena">Cambiar contraseña</a>
      <a href="/terminos">Términos</a>
      <a href="/privacidad">Privacidad</a>
    </nav>
  </div>
</section>

<p class="panel-aviso" role="status" aria-live="polite" data-aviso></p>

<%- include('partials/dock', { activo: 'perfil' }) %>

<%- include('partials/footer') %>
